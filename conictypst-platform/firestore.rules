rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The browser never receives privileged write access. All lifecycle changes
    // go through authenticated callable functions using the Admin SDK.
    match /platformAdmins/{uid} {
      allow get: if isSelf(uid);
      allow list, create, update, delete: if false;
    }

    match /users/{uid} {
      allow get: if isSelf(uid);
      allow list, create, update, delete: if false;
    }

    match /products/{productId} {
      // Product names/defaults are not sensitive and are useful to account UIs.
      allow read: if signedIn();
      allow write: if false;

      match /members/{uid} {
        allow get: if isSelf(uid);
        allow list, create, update, delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /adminAudit/{entryId} {
      allow read, write: if false;
    }

    match /adminMutations/{mutationId} {
      allow read, write: if false;
    }

    match /deletionJobs/{jobId} {
      allow read, write: if false;
    }

    // Exam packages, rosters, attempts, grading keys and audit records are
    // intentionally callable-only. In particular, even a document named
    // "publicPackage" is released through an authorization-aware function;
    // no browser receives direct Firestore access.
    match /examClassrooms/{document=**} { allow read, write: if false; }
    match /examJoinCodes/{document=**} { allow read, write: if false; }
    match /examStudentClassLinks/{document=**} { allow read, write: if false; }
    match /examReleases/{document=**} { allow read, write: if false; }
    match /examAnswerKeys/{document=**} { allow read, write: if false; }
    match /examAssignments/{document=**} { allow read, write: if false; }
    match /examAttempts/{document=**} { allow read, write: if false; }
    match /examAttemptCounters/{document=**} { allow read, write: if false; }
    match /examAttemptMutations/{document=**} { allow read, write: if false; }
    match /examTeacherUsage/{document=**} { allow read, write: if false; }
    match /examAudit/{document=**} { allow read, write: if false; }

    // Thống kê tổng hợp Studio (chỉ số đếm, KHÔNG chứa PII): cho đọc công khai
    // để hiển thị "X giáo viên · Y tài liệu" trên web. Chỉ Cloud Function
    // (Admin SDK, bỏ qua rules) được ghi; client không bao giờ ghi được.
    match /stats/studio {
      allow get: if true;
      allow list, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
