{
  "name": "conictypst",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "dev:public": "VITE_APP_MODE=public vite",
    "build": "vite build",
    "build:public": "VITE_APP_MODE=public vite build",
    "preview": "vite preview",
    "preview:public": "VITE_APP_MODE=public vite preview",
    "sync:bank": "cp bank.json typst/bank.json",
    "deploy": "npm run build:public && wrangler pages deploy dist --project-name conictypsst",
    "deploy:pages": "npm run build:public && wrangler pages deploy dist --project-name conictypsst",
    "deploy:workers": "npm run build:public && wrangler deploy",
    "deploy:gh-pages": "VITE_APP_MODE=public vite build --base=/conictypst/ && gh-pages -d dist",
    "bank:stat": "node scripts/bank-stat.js",
    "bank:search": "node scripts/bank-stat.js",
    "bank:gen-id": "node scripts/gen-id.js",
    "new:exam": "node scripts/new-exam.js",
    "compile:exam": "sh -c 'exam=${npm_config_de:-$1}; typst compile --font-path src/assets/fonts --font-path fonts \"typst/exams/$exam.typ\" --root .' --",
    "compile:beamer": "sh -c 'exam=${npm_config_de:-$1}; typst compile --font-path src/assets/fonts --font-path fonts \"typst/exams/${exam}-beamer.typ\" --root .' --",
    "compile:Beamer": "typst compile --font-path src/assets/fonts --font-path fonts --root . --input beamer=1 typst/Beamer.typ",
    "watch:Beamer": "typst watch --font-path src/assets/fonts --font-path fonts --root . --input beamer=1 typst/Beamer.typ",
    "watch:exam": "sh -c 'exam=${npm_config_de:-$1}; typst watch --font-path src/assets/fonts --font-path fonts \"typst/exams/$exam.typ\" --root .' --",
    "export:figs": "node scripts/export-figs.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@myriaddreamin/typst-ts-renderer": "^0.7.0-rc2",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0-rc2",
    "@myriaddreamin/typst.ts": "^0.7.0-rc2",
    "@tailwindcss/vite": "^4.3.0",
    "clsx": "^2.1.1",
    "docx": "^9.6.1",
    "file-saver": "^2.0.5",
    "katex": "^0.16.46",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "react-katex": "^3.1.0",
    "react-resizable-panels": "^4.10.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@rollup/plugin-wasm": "^6.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.0",
    "gh-pages": "^6.3.0",
    "rollup": "^4.60.2",
    "vite": "^8.0.10",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.6.0",
    "wrangler": "^4.86.0"
  },
  "type": "module"
}
