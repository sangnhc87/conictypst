        #text(7pt)[SANG MATH OMR]\
        #text(7pt)[Họ và tên: \....................................................................] \
        #text(7pt)[Lớp: ........................ Môn: ........................ Điểm: ..............]
      ]
    ]),
    grid.cell([
      #pad(x: 4pt, y: 16pt)[
        #align(center)[
          #qr-code("OMR: SANG MATH|Mã đề", width: 24pt)
        ]
      ]
    ])
  )
])

