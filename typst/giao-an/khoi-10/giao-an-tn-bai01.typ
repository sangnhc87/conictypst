#import "../modules/giao-an.typ": *

#show: giao-an.with(
  truong:    "THPT NGUYỄN HỮU CẢNH",
  to:        "TỔ TRẢI NGHIỆM - HƯỚNG NGHIỆP",
  giao-vien: "Nguyễn Văn Sang",
  ten-bai:   "CHỦ ĐỀ 1. PHÁT HUY TRUYỀN THỐNG NHÀ TRƯỜNG",
  thoi-gian: "2 tiết",
)

// ════════════════════════════════════════════════════════════════════
#phan("I", "MỤC TIÊU")
// ════════════════════════════════════════════════════════════════════

#muc("1", "kiến thức")

- Trình bày được lịch sử hình thành, phát triển và những truyền thống tốt đẹp của nhà trường.
- Nêu được ý nghĩa của việc giữ gìn và phát huy truyền thống nhà trường đối với bản thân và tập thể.
- Đề xuất được các biện pháp, hoạt động cụ thể để góp phần xây dựng và phát huy truyền thống nhà trường.

#muc("2", "năng lực")

*Năng lực đặc thù (Hoạt động Trải nghiệm - Hướng nghiệp):*

#nl("Năng lực thích ứng với cuộc sống")[
  Tự tin, hòa nhập nhanh chóng với môi trường học tập mới ở cấp THPT. Chủ động thiết lập mối quan hệ tích cực với thầy cô và bạn bè.
]
#nl("Năng lực thiết kế và tổ chức hoạt động")[
  Lập kế hoạch và tổ chức được các hoạt động giao lưu, giới thiệu về truyền thống trường lớp (ví dụ: làm báo tường, diễn đàn thanh niên).
]

*Năng lực chung:*

#nl("Năng lực tự chủ và tự học")[Chủ động tìm hiểu thông tin về trường qua phòng truyền thống, website, giáo viên và cựu học sinh.]
#nl("Năng lực giao tiếp và hợp tác")[Tích cực tham gia thảo luận nhóm, biết lắng nghe, tôn trọng ý kiến của người khác và thể hiện được kỹ năng thuyết trình trước đám đông.]

#muc("3", "phẩm chất")

#pc("Yêu nước")[Tự hào về truyền thống nhà trường, từ đó bồi dưỡng tình yêu quê hương, đất nước.]
#pc("Trách nhiệm")[Có ý thức trách nhiệm trong việc bảo vệ danh dự, hình ảnh của trường và tuân thủ nội quy nhà trường.]
#pc("Chăm chỉ")[Có ý thức học tập, rèn luyện tốt để tô thắm thêm truyền thống của trường.]

// ════════════════════════════════════════════════════════════════════
#phan("II", "THIẾT BỊ DẠY HỌC VÀ HỌC LIỆU")
// ════════════════════════════════════════════════════════════════════

- *Giáo viên:* Máy chiếu, laptop, tư liệu/video về lịch sử hình thành và các thành tích nổi bật của nhà trường, thẻ màu, giấy A0, bút dạ.
- *Học sinh:* Vở ghi chép, tìm hiểu trước về lịch sử và truyền thống nhà trường qua các kênh thông tin.

// ════════════════════════════════════════════════════════════════════
#phan("III", "TIẾN TRÌNH DẠY HỌC")
// ════════════════════════════════════════════════════════════════════

// ─── HOẠT ĐỘNG 1: MỞ ĐẦU ──────────────────────────────────────────────
#hd(1, "Xác định nhiệm vụ học tập / Khởi động", 15)

#ten-hd[[Trò chơi: Mảnh ghép truyền thống]]
#mt-hd[[Tạo hứng thú, khơi gợi hiểu biết ban đầu của học sinh về nhà trường.]]
#nd-hd[
  - GV chia lớp thành 4 nhóm. Phát cho mỗi nhóm một bộ mảnh ghép (hình ảnh về các góc thân quen của trường, các cựu học sinh ưu tú, các sự kiện truyền thống).
  - Yêu cầu các nhóm ghép hoàn chỉnh bức tranh trong thời gian 3 phút và nêu tên bức tranh.
]
#sp-hd[
  - Bức tranh hoàn chỉnh của các nhóm.
]
#tc-hd[
  #buoc(1, "Giao nhiệm vụ", 2)[GV chia nhóm, phát mảnh ghép và phổ biến luật chơi.]
  #buoc(2, "Thực hiện nhiệm vụ", 5)[HS tích cực thảo luận và ghép tranh.]
  #buoc(3, "Báo cáo, thảo luận", 5)[Đại diện các nhóm dán bức tranh lên bảng và chia sẻ những điều mình biết về bức tranh đó.]
  #buoc(4, "Kết luận, nhận định", 3)[GV nhận xét, khen ngợi sự nhanh nhạy của các nhóm và dẫn dắt vào bài mới.]
]

// ─── HOẠT ĐỘNG 2: HÌNH THÀNH KIẾN THỨC ────────────────────────────────
#hd(2, "Hình thành kiến thức mới", 45)

#ten-hd[[Tìm hiểu lịch sử và truyền thống nhà trường]]
#mt-hd[[Học sinh nêu được các cột mốc lịch sử, thành tích nổi bật và những giá trị cốt lõi của trường.]]
#nd-hd[
  - GV chiếu video clip/slideshow tóm tắt về lịch sử trường.
  - Các nhóm 1&2 tìm hiểu cột mốc lịch sử.
  - Các nhóm 3&4 tìm hiểu ý nghĩa tên trường và truyền thống (dạy tốt, học tốt).
]
#sp-hd[
  - Giấy A0 ghi chép các thông tin của các nhóm.
]
#tc-hd[
  #buoc(1, "Giao nhiệm vụ", 5)[GV chiếu video và chia nhiệm vụ cho 4 nhóm.]
  #buoc(2, "Thực hiện nhiệm vụ", 20)[HS kết hợp thông tin từ video để thảo luận, ghi ra giấy A0.]
  #buoc(3, "Báo cáo, thảo luận", 15)[Các nhóm treo giấy A0 và trình bày chéo (Kỹ thuật phòng tranh).]
  #buoc(4, "Kết luận, nhận định", 5)[GV chốt lại các mốc son lịch sử quan trọng.]
]

// ─── HOẠT ĐỘNG 3: LUYỆN TẬP / THỰC HÀNH ────────────────────────────────
#hd(3, "Thực hành - Vận dụng", 30)

#ten-hd[[Xây dựng Kế hoạch 'Tiếp bước truyền thống']]
#mt-hd[[Học sinh đề xuất được các hoạt động cụ thể, vừa sức để giữ gìn truyền thống.]]
#nd-hd[
  - Tình huống: "Nếu được giao nhiệm vụ thiết kế một dự án nhỏ nhằm lan tỏa hình ảnh đẹp của trường, nhóm em sẽ làm gì?"
  - Lập Kế hoạch hành động (Tên dự án, mục đích, đối tượng, các bước).
]
#sp-hd[
  - Bản kế hoạch dự án của từng nhóm (vd: Xanh hóa lớp học, Radio học đường...).
]
#tc-hd[
  #buoc(1, "Giao nhiệm vụ", 5)[GV đưa ra tình huống và yêu cầu các nhóm lên ý tưởng.]
  #buoc(2, "Thực hiện nhiệm vụ", 10)[Các nhóm brainstorm ý tưởng và viết ra nháp.]
  #buoc(3, "Báo cáo, thảo luận", 10)[Gọi 2-3 nhóm lên thuyết trình. Các nhóm khác đóng vai 'Ban giám khảo' phản biện.]
  #buoc(4, "Kết luận, nhận định", 5)[GV đánh giá tính khả thi và khuyến khích thực hiện thực tế.]
]
