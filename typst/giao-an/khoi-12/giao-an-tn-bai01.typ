#import "../modules/giao-an.typ": *

#show: giao-an.with(
  truong:    "THPT NGUYỄN HỮU CẢNH",
  to:        "TỔ TRẢI NGHIỆM - HƯỚNG NGHIỆP",
  giao-vien: "Nguyễn Văn Sang",
  ten-bai:   "CHỦ ĐỀ: KẾ HOẠCH ĐỊNH HƯỚNG NGHỀ NGHIỆP TƯƠNG LAI",
  thoi-gian: "2 tiết",
)

// ════════════════════════════════════════════════════════════════════
#phan("I", "MỤC TIÊU")
// ════════════════════════════════════════════════════════════════════

#muc("1", "kiến thức")
- Phân tích được các xu hướng thị trường lao động (AI, Tự động hóa).
- Nắm vững các bước cơ bản lập kế hoạch nghề nghiệp.

#muc("2", "năng lực")
*Năng lực đặc thù:*
#nl("Năng lực định hướng nghề nghiệp")[
  Xác định được nhóm nghề phù hợp thông qua trắc nghiệm Holland.
]
#nl("Năng lực thiết kế và tổ chức hoạt động")[
  Thiết kế được bản CV và Kế hoạch học tập ngắn hạn.
]

*Năng lực chung:*
#nl("Năng lực tự chủ và tự học")[Tự tìm kiếm thông tin điểm chuẩn các trường ĐH.]
#nl("Năng lực giải quyết vấn đề")[Xử lý tình huống bất đồng quan điểm chọn nghề với gia đình.]

#muc("3", "phẩm chất")
#pc("Trách nhiệm")[Nghiêm túc với tương lai nghề nghiệp của bản thân.]
#pc("Chăm chỉ")[Có ý thức nỗ lực học tập để thi đỗ ĐH/CĐ.]

// ════════════════════════════════════════════════════════════════════
#phan("II", "THIẾT BỊ DẠY HỌC VÀ HỌC LIỆU")
// ════════════════════════════════════════════════════════════════════
- Máy chiếu, link trắc nghiệm Holland, giấy A4, bút màu.

// ════════════════════════════════════════════════════════════════════
#phan("III", "TIẾN TRÌNH DẠY HỌC")
// ════════════════════════════════════════════════════════════════════

#hd(1, "Xác định nhiệm vụ học tập / Khởi động", 15)
#ten-hd[[AI và Thế giới nghề nghiệp]]
#mt-hd[[Tạo sự chú ý về biến động thị trường lao động.]]
#nd-hd[
  - GV chiếu hình Robot viết code và ChatGPT làm thơ.
  - Hỏi: "Trong 10 năm tới, ngành nào biến mất, ngành nào lên ngôi?"
]
#sp-hd[Câu trả lời của HS về sự thay đổi của nghề nghiệp.]
#tc-hd[
  #buoc(1, "Giao nhiệm vụ", 2)[GV chiếu hình ảnh, đặt câu hỏi.]
  #buoc(2, "Thực hiện", 5)[HS Think-Pair-Share.]
  #buoc(3, "Báo cáo", 5)[HS giơ tay phát biểu.]
  #buoc(4, "Kết luận", 3)[GV nhận định: Phải chọn nghề phù hợp nhu cầu XH.]
]

#hd(2, "Hình thành kiến thức mới", 45)
#ten-hd[[Bài test Holland – Tôi là ai trong thế giới nghề nghiệp?]]
#mt-hd[[HS xác định được nhóm tính cách nghề nghiệp nổi trội.]]
#nd-hd[
  - Làm bài trắc nghiệm Holland (6 nhóm).
  - Tìm ra 2 nhóm mã nổi trội nhất của bản thân.
]
#sp-hd[Kết quả 2 mã Holland nổi trội của từng HS.]
#tc-hd[
  #buoc(1, "Giao nhiệm vụ", 3)[Cung cấp QR code trắc nghiệm.]
  #buoc(2, "Thực hiện", 15)[HS cá nhân làm bài trên điện thoại.]
  #buoc(3, "Báo cáo", 15)[GV gọi các nhóm đứng lên theo kết quả.]
  #buoc(4, "Kết luận", 12)[Phân tích đặc điểm nhóm nghề tương ứng.]
]

#hd(3, "Thực hành - Vận dụng", 30)
#ten-hd[[Xây dựng Bản đồ tương lai & CV Mini]]
#mt-hd[[HS lập được Bản đồ tương lai và phác thảo CV.]]
#nd-hd[
  - Mặt trước A4: Mục tiêu trường/ngành, tổ hợp môn, kế hoạch tăng điểm.
  - Mặt sau A4: Phác thảo CV (Kỹ năng, Thành tích).
]
#sp-hd[Bản đồ tương lai và CV Mini của mỗi HS.]
#tc-hd[
  #buoc(1, "Giao nhiệm vụ", 2)[Phát giấy A4, nêu yêu cầu.]
  #buoc(2, "Thực hiện", 15)[HS làm việc cá nhân, vẽ và viết.]
  #buoc(3, "Báo cáo", 8)[Mời 2-3 HS thuyết trình sản phẩm.]
  #buoc(4, "Kết luận", 5)[Động viên các em nỗ lực theo đuổi mục tiêu.]
]
