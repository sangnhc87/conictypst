#let pc-phapcu-note-for(ch) = {
  if ch == 1 [
  *Pháp Cú 1:* Ý dẫn đầu các pháp,
  Ý làm chủ, ý tạo;
  Nếu với ý ô nhiễm,
  Nói lên hay hành động,
  Khổ não bước theo sau,
  Như xe, chân vật kéo.

  *Pháp Cú 5:* Hận thù diệt hận thù,
  Đời này không có được.
  Từ bi diệt hận thù,
  Là định luật ngàn thu.
  ] else   if ch == 2 [
  *Pháp Cú 21:* Không phóng dật, đường sống,
  Phóng dật là đường chết.
  Không phóng dật, không chết,
  Phóng dật như chết rồi.

  *Pháp Cú 24:* Người nỗ lực, chánh niệm,
  Làm sạch, ở cẩn thận,
  Tự chế, sống đúng pháp,
  Danh xưng luôn tăng trưởng.
  ] else   if ch == 3 [
  *Pháp Cú 33:* Tâm hoảng hốt, dao động,
  Khó hộ trì, khó nhiếp,
  Người trí làm tâm thẳng,
  Như thợ tên nắn tên.

  *Pháp Cú 42:* Kẻ thù hại kẻ thù,
  Oan gia hại oan gia,
  Không bằng tâm hướng ác,
  Gây ác quả cho mình.
  ] else   if ch == 4 [
  *Pháp Cú 50:* Không nên nhìn lỗi người,
  Người làm hay không làm;
  Nên nhìn tự chính mình,
  Có làm hay không làm.

  *Pháp Cú 54:* Hương các loại hoa thơm,
  Không ngược bay chiều gió,
  Hương người đức hạnh tốt,
  Ngược gió bay muôn phương.
  ] else   if ch == 5 [
  *Pháp Cú 61:* Đường dài cho kẻ mệt,
  Đêm dài cho kẻ thức,
  Luân hồi dài, kẻ ngu,
  Không biết chân diệu pháp.

  *Pháp Cú 62:* "Con tôi, tài sản tôi",
  Kẻ ngu ôm sầu não.
  Tự mình không của mình,
  Con đâu, tài sản đâu?
  ] else   if ch == 6 [
  *Pháp Cú 76:* Nếu thấy bậc Hiền trí,
  Chỉ lỗi và khiển trách,
  Như chỉ chỗ chôn vàng,
  Hãy kết hợp người trí!

  *Pháp Cú 80:* Người tưới nước dẫn nước,
  Kẻ làm tên nắn tên,
  Người thợ mộc uốn gỗ,
  Bậc hiền trí nhiếp tâm.
  ] else   if ch == 7 [
  *Pháp Cú 90:* Trình độ đã vượt qua,
  Hành trình đã kết thúc,
  Mọi hệ lụy xả bỏ,
  Khổ não không còn nữa.

  *Pháp Cú 98:* Làng mạc hay rừng núi,
  Thung lũng hay đồi cao,
  La-hán trú chỗ nào,
  Đất ấy thật khả ái.
  ] else   if ch == 8 [
  *Pháp Cú 100:* Tốt hơn một tiếng có nghĩa,
  Làm cho người nghe an tịnh;
  Hơn ngàn tiếng vô nghĩa,
  Chỉ gây thêm phiền toái.

  *Pháp Cú 103:* Tự chiến thắng chính mình,
  Hơn ngàn vạn lần chiến thắng;
  Chiến thắng bản thân mình,
  Là chiến công oanh liệt nhất.
  ] else   if ch == 9 [
  *Pháp Cú 116:* Hãy gấp làm điều thiện,
  Ngăn tâm làm điều ác.
  Ai chậm làm việc lành,
  Tâm ưa thích việc ác.

  *Pháp Cú 121:* Chớ khinh thường điều ác,
  Cho rằng "chưa đến mình",
  Như bình nước nhỏ giọt,
  Lâu ngày cũng đầy tràn.
  ] else   if ch == 10 [
  *Pháp Cú 129:* Ai cũng sợ gươm đao,
  Ai cũng sợ sự chết.
  Suy ta ra lòng người,
  Chớ giết, chớ bảo giết.

  *Pháp Cú 133:* Chớ nói lời thô ác,
  Người nghe sẽ trả lời.
  Khổ thay lời phẫn nộ,
  Gươm trượng sẽ chạm nhau.
  ] else   if ch == 11 [
  *Pháp Cú 146:* Cười gì, hân hoan gì,
  Khi đời cứ cháy mòn?
  Bị tối tăm bao bọc,
  Sao không tìm ngọn đèn?

  *Pháp Cú 152:* Người ít nghe ít học,
  Lớn lên như trâu con,
  Thịt nó tuy lớn lên,
  Trí tuệ không tăng trưởng.
  ] else   if ch == 12 [
  *Pháp Cú 159:* Nếu tự mình làm được,
  Điều mình dạy người khác,
  Tự nhiếp, mới nhiếp người,
  Tự nhiếp thật là khó.

  *Pháp Cú 160:* Tự mình làm chỗ nương,
  Ai khác làm chỗ nương?
  Tự mình khéo điều phục,
  Được chỗ nương khó được.
  ] else   if ch == 13 [
  *Pháp Cú 167:* Chớ theo pháp hạ liệt,
  Chớ sống với buông lung,
  Chớ theo tà kiến vọng,
  Chớ tăng trưởng thế gian.

  *Pháp Cú 170:* Hãy nhìn như bọt nước,
  Hãy nhìn như cảnh huyễn,
  Quán nhìn thế gian vậy,
  Thần chết không thấy hình.
  ] else   if ch == 14 [
  *Pháp Cú 183:* Không làm mọi điều ác,
  Thành tựu các hạnh lành,
  Tâm ý giữ trong sạch,
  Chính lời chư Phật dạy.

  *Pháp Cú 188:* Loài người sợ hiểm nguy,
  Đi tìm nhiều chỗ trú,
  Vào rừng hay đền tháp,
  Cội cây hay núi non...
  ] else   if ch == 15 [
  *Pháp Cú 197:* Vui thay, chúng ta sống,
  Không hận, giữa hận thù;
  Giữa những người ân oán,
  Ta sống không hận thù.

  *Pháp Cú 204:* Vô bệnh, lợi tối thượng,
  Bằng lòng, giàu tối thượng,
  Thành tín, bạn tối thượng,
  Niết-bàn, lạc tối thượng.
  ] else   if ch == 16 [
  *Pháp Cú 211:* Chớ dính dấp vật gì,
  Với ác hay với thiện.
  Không thấy vật mình thích,
  Và thấy vật không thích,
  Cả hai đều sinh khổ.

  *Pháp Cú 212:* Từ hỷ ái sinh sầu,
  Từ hỷ ái sinh sợ.
  Ai giải thoát hỷ ái,
  Không sầu, đâu có sợ?
  ] else   if ch == 17 [
  *Pháp Cú 223:* Lấy không giận thắng giận,
  Lấy thiện thắng bất thiện.
  Lấy thí thắng xan tham,
  Lấy chân thắng hư ngụy.

  *Pháp Cú 227:* Xưa vậy, nay cũng vậy:
  Ngồi im bị người chê,
  Nói nhiều bị người chê,
  Nói vừa bị người chê.
  Làm người, ai không bị chê?
  ] else   if ch == 18 [
  *Pháp Cú 235:* Giờ đây ngươi như lá úa,
  Sứ giả Thần chết kề cận,
  Ngươi đang đứng ở cửa tử,
  Hành trang ngươi chưa có gì!

  *Pháp Cú 239:* Bậc trí theo từng bậc,
  Từng lúc, từng sát-na,
  Trừ cấu uế của mình,
  Như thợ vàng rèn bạc.
  ] else   if ch == 19 [
  *Pháp Cú 256:* Người xử sự gấp gáp,
  Không phải người Pháp trụ.
  Bậc trí suy xét kỹ,
  Cả hai, chánh và tà.

  *Pháp Cú 268:* Không phải do im lặng,
  Trở thành bậc ẩn sĩ;
  Người cầm cân tội phước,
  Nắm giữ điều tốt lành.
  ] else   if ch == 20 [
  *Pháp Cú 273:* Trong các đường, Bát chánh,
  Trong các sự, Tứ đế,
  Trong các pháp, Vô tham,
  Trong các loài, Chánh giác.

  *Pháp Cú 277:* "Tất cả hành vô thường",
  Với tuệ quán thấy vậy,
  Nhàm chán đối với khổ,
  Đó là đường thanh tịnh.
  ] else   if ch == 21 [
  *Pháp Cú 290:* Nếu từ bỏ chút vui,
  Nhìn thấy được vui lớn,
  Bậc trí xả vui nhỏ,
  Để hướng đến vui lớn.

  *Pháp Cú 292:* Việc đáng làm không làm,
  Việc không đáng lại làm,
  Người ngạo mạn phóng dật,
  Lậu hoặc ngày càng tăng.
  ] else   if ch == 22 [
  *Pháp Cú 306:* Người nói láo đọa địa ngục,
  Người làm nói không làm.
  Cả hai, sau khi chết,
  Đều chịu khổ như nhau.

  *Pháp Cú 313:* Nếu có việc đáng làm,
  Hãy làm với hết lòng.
  Kẻ tu hành lỏng lẻo,
  Chỉ khuấy thêm bụi đời.
  ] else   if ch == 23 [
  *Pháp Cú 320:* Như voi giữa trận mạc,
  Chịu đựng cung tên bắn,
  Ta chịu đựng phỉ báng,
  Giữa những người ác tâm.

  *Pháp Cú 328:* Nếu tìm được bạn hiền,
  Đồng hành, khéo trú trí,
  Hãy vượt mọi hiểm nguy,
  Đi cùng tâm hoan hỷ.
  ] else   if ch == 24 [
  *Pháp Cú 334:* Của người sống buông lung,
  Ái dục tăng như sừng.
  Người ấy chạy đây đó,
  Như vượn tìm trái cây.

  *Pháp Cú 348:* Buông quá khứ, buông tương lai,
  Buông luôn cả hiện tại,
  Đến bờ kia cuộc đời,
  Ý giải thoát mọi phần.
  ] else   if ch == 25 [
  *Pháp Cú 360:* Khéo thay phòng hộ mắt,
  Khéo thay phòng hộ tai.
  Khéo thay phòng hộ mũi,
  Khéo thay phòng hộ lưỡi.

  *Pháp Cú 365:* Chớ khinh điều mình được,
  Chớ ganh điều người được.
  Tỷ kheo ganh tỵ người,
  Không thể đạt định tâm.
  ] else   if ch == 26 [
  *Pháp Cú 383:* Hãy tinh tấn dứt dòng,
  Từ bỏ mọi dục lạc.
  Biết các hành diệt tận,
  Ngươi sẽ biết Vô vi.

  *Pháp Cú 391:* Ai ý, thân, và khẩu,
  Không làm việc ác sai,
  Ba nghiệp được phòng hộ,
  Ta gọi Bà-la-môn.
  ] else {
    none
  }
}
