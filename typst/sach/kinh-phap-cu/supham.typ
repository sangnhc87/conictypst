// ═══════════════════════════════════════════════════════════
// GÓC NHÌN SƯ PHẠM — Kinh Pháp Cú
// Mỗi phẩm một ghi chú cho giáo viên Toán phổ thông
// ═══════════════════════════════════════════════════════════

#let _pc-supham-notes = (
  [
    Trong lớp Toán, tâm thế đi trước kỹ thuật. Trước một bài khó, thầy cô có thể cho cả lớp 30 giây đọc đề im lặng, gạch dữ kiện và tự nhắc mình làm từng bước. Nghi thức nhỏ ấy giúp học sinh bước vào bài bằng bình tĩnh thay vì hoảng.
  ],
  [
    "Không phóng dật" trong lớp học là cẩn thận ở chỗ nhỏ. Hãy cho học sinh một checklist rất ngắn trước khi nộp bài: đọc lại dấu, giữ điều kiện, thử lại kết quả. Năng lực bền thường được xây từ những lần tự kiểm như vậy.
  ],
  [
    Tâm học trò rất dễ nhảy từ đề bài sang điểm số, từ dữ kiện sang lo lắng. Khi dạy bài khó, nên buộc nhịp lớp chậm lại ở ba thao tác đầu: đọc hết đề, khoanh dữ kiện, nói rõ bước đầu tiên sẽ làm gì. Khả năng ở lại với một bước là nền của tư duy Toán.
  ],
  [
    Khi soạn bài, đừng nhồi quá nhiều "hoa" mà thiếu mật. Mỗi tiết nên có một lõi thật rõ: một ý, một dạng nhìn, một sai lầm cần sửa. Dạy ít hơn nhưng sáng hơn thường hiệu quả hơn dạy nhiều mà trôi.
  ],
  [
    Học sinh yếu không chỉ yếu ở kiến thức; nhiều em yếu ở chỗ quá lâu mới chịu nhận mình chưa hiểu. Trong lớp, nên làm cho câu "em chưa ra" trở thành một tín hiệu tốt để bắt đầu gỡ bài, không phải một lời thú nhận đáng xấu hổ. Lớp học càng bớt thưởng cho việc giả hiểu, học thật càng có chỗ sống.
  ],
  [
    Một người bạn học tốt hay một nhóm chữa bài nghiêm túc có giá trị rất lớn với học sinh Toán. Hãy dành những đoạn ngắn để học sinh đổi vở, chỉ ra một chỗ đúng và một chỗ cần sửa cho nhau. Phê bình tử tế là một kỹ năng học tập, không chỉ là một kỹ năng ứng xử.
  ],
  [
    Phẩm này nhắc mạnh về sự điềm tĩnh của người dạy. Không phải tiết nào cũng cần bùng nổ; nhiều khi điều học sinh cần nhất là thấy thầy cô không bị quăng quật bởi từng lỗi nhỏ. Sự vững của giáo viên chính là khung an toàn tinh thần cho lớp.
  ],
  [
    Một bài toán thật hiểu thường quý hơn rất nhiều chục bài chép theo mẫu. Mỗi buổi nên có ít nhất một bài được dừng đủ lâu để học sinh nói ra vì sao chọn hướng ấy, không chỉ viết ra kết quả. Chiều sâu phải được tổ chức thành thời gian cụ thể, không tự nhiên mà có.
  ],
  [
    Những lỗi nhỏ lặp đi lặp lại như quên điều kiện, sai dấu hay bỏ kết luận chính là "từng giọt" làm đầy chum thói quen xấu. Nên cho học sinh giữ một sổ lỗi cá nhân rất ngắn, chỉ ghi ba lỗi mình hay mắc nhất và cách tự nhắc. Sửa chuỗi thói quen luôn hiệu quả hơn chữa từng bài lẻ.
  ],
  [
    Trong lớp Toán, đừng dùng nỗi sợ làm động cơ chính. Có thể sửa rất chắc mà vẫn không làm nhục học sinh, nhất là với lỗi công khai trước lớp. Một nguyên tắc đơn giản là phê vào bài và vào cách làm, không phán vào con người.
  ],
  [
    Kiến thức cũng "già đi" nếu không được ôn lại đúng lúc. Thay vì chờ tới sát kiểm tra, nên cài những đoạn ôn 5 phút đầu giờ để gọi lại công thức, lỗi cũ và dạng quen. Cái học được giữ sống bằng nhịp đều, không phải bằng nước rút.
  ],
  [
    Một mục tiêu lớn của dạy Toán là làm cho học sinh có thể tự học và tự sửa dần. Cuối mỗi lời giải, hãy tập cho các em tự hỏi ba câu: em dùng điều kiện nào, em đang kết luận cái gì, kết quả này có hợp lý không. Tự ngã trong lớp học là năng lực tự quản trí tuệ, không phải làm một mình.
  ],
  [
    Có những bài nhìn rất đẹp bề ngoài nhưng rỗng về lập luận. Vì thế, ngoài chấm đáp án, nên thỉnh thoảng yêu cầu học sinh nói miệng vì sao bước đó hợp lý hoặc vì sao phải tách trường hợp. Trong môn Toán, cái thật nằm ở cấu trúc hiểu chứ không ở bề mặt trơn tru.
  ],
  [
    Một người dạy giỏi không chỉ truyền kiến thức mà còn truyền một nhịp sống: bình tĩnh, rõ ràng, không khoa trương. Với những tiết căng, chỉ cần thầy cô hạ giọng, viết chậm và phân tách bảng cho gọn, lớp đã bớt rối đi nhiều. Học sinh thường tin môn học qua chính thái độ của người dạy.
  ],
  [
    Áp lực thi cử làm lớp học rất dễ mất niềm vui. Hãy giữ lại những khoảnh khắc an lạc nhỏ: một lời giải đẹp, một lỗi được sửa ra, một em yếu hôm nay hiểu hơn hôm qua. Niềm vui nhỏ nhưng thật giúp học sinh đi đường dài với Toán.
  ],
  [
    Nhiều học sinh dính vào một cách làm duy nhất vì nó từng cho cảm giác an toàn. Khi chữa bài, nên cố ý đặt thêm câu hỏi "còn hướng nào khác không" hoặc cho hai nhóm trình bày hai cách tiếp cận khác nhau. Buông một khuôn quen không phải để làm rối, mà để học sinh bớt sợ bài lạ.
  ],
  [
    Khi lớp bắt đầu nóng vì bài khó, vì điểm hay vì so bì, người dạy càng phải giữ nhịp của mình. Một khoảng dừng ngắn, một câu hỏi nhỏ hơn, hoặc cho học sinh viết riêng 1 phút trước khi nói thường hiệu quả hơn quát lớn. Sự bình tĩnh của thầy cô bẻ gãy dây chuyền nóng giận rất nhanh.
  ],
  [
    Cấu uế trong học Toán rất hay là những điều tưởng nhỏ: trình bày cẩu thả, lạm dụng ký hiệu, chép thiếu bước. Đừng sửa tất cả cùng lúc; mỗi tuần chỉ chọn một nếp cần gọt và theo đến cùng. Lớp sáng lên nhờ nhiều lần lau nhỏ, không nhờ một lần hô thật to.
  ],
  [
    Công bằng trong lớp học không phải là chấm ai cũng như nhau theo kiểu máy móc, mà là giữ cùng một chuẩn thật cho mọi người. Nên công khai tiêu chí chấm của một bài tự luận ngắn: đúng ý, đủ lập luận, trình bày rõ. Học sinh rất nhạy với sự thiên lệch, nên cái cân bên trong của người dạy phải nhìn thấy được.
  ],
  [
    Trong dạy Toán, phương pháp quan trọng không kém kết quả. Khi chữa một bài, nên đánh dấu rõ các chỗ rẽ của con đường: vì sao đặt ẩn, vì sao dùng đạo hàm, vì sao tách trường hợp. Học sinh chỉ thật sự có năng lực khi thấy được đường đi chứ không chỉ thấy đích đến.
  ],
  [
    Một lớp mạnh thường được tạo bởi nhiều nề nếp nhỏ hơn là vài giờ cao trào. Hãy cố định vài routine thật bền: ghi điều kiện trước, tự soát kết quả sau, hỏi lại khi chưa rõ. Những viên gạch nhỏ ấy mới là thứ giữ lớp đứng lâu.
  ],
  [
    Nếu lớp sống bằng quay cóp, học tủ và thói quen "miễn qua được", thì sớm muộn các em cũng trả giá ở chỗ hiểu rỗng. Người dạy nên cho thấy hậu quả ấy bằng cách yêu cầu giải thích lại, sửa lại và làm lại chứ không chỉ trừ điểm. Kỷ luật học tập có sức nặng hơn khi nó gắn với việc phải học thật.
  ],
  [
    Bài toán khó cần sức bền. Có những lúc học sinh không thiếu thông minh, chỉ thiếu khả năng ở lại với sự chưa ra lời giải đủ lâu. Nên có những bài mà thầy cô chủ ý không cứu quá sớm để các em luyện sức chịu lực trí tuệ.
  ],
  [
    Nhiều em tích lũy quá nhiều công thức, mẹo và tài liệu, nhưng càng nhiều càng rối vì không biết cái gì là gốc. Thầy cô nên giúp các em dựng sơ đồ lõi của từng chương: vài ý trung tâm, vài dấu hiệu nhận dạng dạng bài. Giữ được gốc rồi mới thêm cành lá thì lớp mới bớt rối.
  ],
  [
    "Làm nhẹ thuyền" trong lớp Toán là bớt những gánh nặng không cần thiết: ghi chép rườm rà, mẫu giải dài thừa, tham quá nhiều dạng trong một tiết. Khi soạn bài, hãy tự hỏi phần nào học sinh thật sự phải giữ lại và phần nào chỉ đang làm nặng đầu. Bỏ bớt đúng chỗ giúp các em còn sức cho phần học thật.
  ],
  [
    Đừng đánh giá học sinh bằng nhãn xuất phát như "học trường này" hay "em thuộc nhóm yếu". Tốt hơn là theo dõi tiến bộ bằng những dấu hiệu rất thật: hôm nay em trình bày rõ hơn chưa, tự kiểm tốt hơn chưa, dám sửa sai hơn chưa. Niềm tin giáo dục bắt đầu từ cách người dạy nhìn sự trưởng thành chứ không nhìn cái mác.
  ],
)

#let pc-supham-note-for(number) = {
  if number >= 1 and number <= _pc-supham-notes.len() {
    _pc-supham-notes.at(number - 1)
  } else {
    none
  }
}
