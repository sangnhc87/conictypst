// KỆ TIÊU BIỂU — Kinh Pháp Cú
// Mỗi phẩm một câu kệ ngắn để giữ được giọng gốc của bản kinh
// ═══════════════════════════════════════════════════════════

#let _pc-trich-notes = (
  (
    [
      "Tâm dẫn đầu các pháp, tâm làm chủ, tâm tạo tác."

      "Tâm nhiễm ô thì khổ theo sau; tâm thanh tịnh thì an lạc theo sau."

      "Hận thù không dập bằng hận thù; chỉ có không hận mới làm hận dừng."
    ],
    [Phẩm Song Yếu],
  ),
  (
    [
      "Không phóng dật là con đường bất tử; phóng dật là con đường của chết."

      "Người tỉnh thức thật sự thì không chết; kẻ phóng dật như đã chết rồi."

      "Như người giữ thành biết canh cửa, người biết giữ tâm thì sống lâu trong sáng."
    ],
    [Phẩm Không Phóng Dật],
  ),
  (
    [
      "Tâm khó thấy, rất nhiệm mầu, thường chạy theo điều nó muốn."

      "Người trí nên giữ tâm, vì tâm được gìn giữ đem lại an lạc."

      "Như người thợ uốn mũi tên cho thẳng, người tu sửa dần cái tâm luôn động."
    ],
    [Phẩm Tâm],
  ),
  (
    [
      "Đừng chỉ nhìn hoa đẹp rồi mải mê đi hái mà quên ngày sống đang ngắn lại."

      "Như ong đến hoa, lấy mật mà không làm hại sắc hương, bậc hiền đi qua đời cũng nên như thế."

      "Chỉ nhặt điều tinh nhất mà không tàn phá điều mình đang nương vào."
    ],
    [Phẩm Hoa],
  ),
  (
    [
      "Kẻ ngu dù gần bậc trí suốt đời cũng không nếm được Pháp, như cái muỗng không nếm được vị canh."

      "Người ngu tưởng mình khôn nên càng khó thấy chỗ sai của mình."

      "Thà đi một mình còn hơn đồng hành lâu dài với đường lối đưa mình xuống thấp."
    ],
    [Phẩm Ngu],
  ),
  (
    [
      "Nếu gặp người chỉ lỗi, ngăn điều sai và chỉ đường lành, hãy gần người ấy như gần một kho báu."

      "Người hiền nhắc điều khó nghe nhưng giữ cho đời ta khỏi đi lệch."

      "Theo người trí là theo một ngọn đèn, không phải chỉ theo một lời khen."
    ],
    [Phẩm Hiền Trí],
  ),
  (
    [
      "Đường đi của người đã hết lậu hoặc khó dò như dấu chim giữa hư không."

      "Người ấy đi qua đời mà lòng không còn mắc lại vào những lưới cũ."

      "Tự do sâu nhất là bớt bị tham ái và danh vọng cầm lái."
    ],
    [Phẩm A La Hán],
  ),
  (
    [
      "Hơn ngàn lời vô ích, một lời có nghĩa đem lại an tịnh vẫn hơn."

      "Hơn ngàn chiến thắng ngoài kia, một lần thắng được mình vẫn hơn."

      "Một ngày thấy đúng điều cốt lõi còn hơn trăm năm sống lơ mơ."
    ],
    [Phẩm Ngàn],
  ),
  (
    [
      "Chớ coi thường điều ác mà nghĩ rằng nó chưa đến với ta."

      "Từng giọt nước rơi lâu ngày cũng làm đầy chum; từng lỗi nhỏ nuôi lâu ngày cũng thành tính."

      "Điều ác thường ngọt lúc đầu nhưng đắng khi quả chín."
    ],
    [Phẩm Ác],
  ),
  (
    [
      "Mọi người đều run sợ trước hình phạt; mọi người đều quý mạng sống."

      "Lấy mình làm ví, chớ giết, chớ bảo giết."

      "Biết mình sợ đau thế nào thì cũng biết người khác đau như thế."
    ],
    [Phẩm Hình Phạt],
  ),
  (
    [
      "Thân này rồi sẽ nằm trên đất, bị quăng bỏ, vô thức như khúc gỗ vô dụng."

      "Tuổi trẻ, sắc đẹp và sức lực đều không đứng yên với ai."

      "Nhớ sự già đi không phải để buồn, mà để đừng sống hoang phí."
    ],
    [Phẩm Già],
  ),
  (
    [
      "Chính mình là chỗ nương của mình; còn ai khác có thể là chỗ nương?"

      "Tự khéo điều phục mình, người ta được chỗ nương khó được."

      "Không ai đi thay đoạn đường tu sửa cốt lõi của ta được."
    ],
    [Phẩm Tự Ngã],
  ),
  (
    [
      "Hãy nhìn thế gian như bọt nước, như ảo ảnh."

      "Ai thấy đời như vậy, thần chết khó tìm được người ấy."

      "Đừng gửi trọn lòng mình vào điều chỉ đẹp ở bề mặt và tan rất nhanh."
    ],
    [Phẩm Thế Gian],
  ),
  (
    [
      "Người đã vượt qua đường hiểm, không còn sầu, không còn trói buộc, người ấy là bậc giác ngộ."

      "Bậc tỉnh không được nhận ra bằng huyền thoại, mà bằng độ sáng của thấy biết và độ vững của tâm."

      "Gặp xúc phạm mà không nhận lấy, đó đã là dáng của người tự do."
    ],
    [Phẩm Phật],
  ),
  (
    [
      "An lạc thay, ta sống không oán giữa những người ôm oán."

      "Giữa người bệnh, người tranh và người thiếu, vẫn có thể giữ một nhịp bình an bên trong."

      "An lạc không luôn đợi hoàn cảnh sạch rồi mới tới."
    ],
    [Phẩm An Lạc],
  ),
  (
    [
      "Từ ái sinh sầu, từ ái sinh sợ; ai thoát khỏi ái, không còn sầu, sao còn sợ?"

      "Hễ bám vào đâu quá chặt thì đã bắt đầu sợ mất ở đó."

      "Thương không nhất thiết phải biến thành dính."
    ],
    [Phẩm Ái],
  ),
  (
    [
      "Lấy không giận thắng giận, lấy lành thắng dữ, lấy thí thắng xan, lấy thật thắng dối."

      "Cơn giận đốt người cầm nó trước khi làm bỏng người khác."

      "Thắng nóng nảy là một chiến thắng khó hơn nhiều chiến thắng ngoài đời."
    ],
    [Phẩm Phẫn Nộ],
  ),
  (
    [
      "Dần dần, từng lúc một, người trí gột sạch cấu uế của mình như thợ vàng gột sạch cặn bẩn khỏi bạc."

      "Điều đục không mất đi nhờ một lời hứa lớn, mà nhờ nhiều lần bỏ bớt thật nhỏ."

      "Bền bỉ làm sạch quý hơn bộc phát rồi bỏ ngang."
    ],
    [Phẩm Cấu Uế],
  ),
  (
    [
      "Không phải bởi nói nhiều mà thành người trì pháp."

      "Ai nghe ít mà thấy pháp, không phóng dật, người ấy mới thật là người trì pháp."

      "Tuổi tác, vai trò và lời đẹp không thay được công chính."
    ],
    [Phẩm Pháp Trụ],
  ),
  (
    [
      "Trong các con đường, đường tám ngành là hơn hết; trong các chân lý, bốn chân lý là hơn hết."

      "Biết tên con đường chưa phải là đi đường."

      "Thấy đúng, nói đúng và sống đúng phải đi cùng nhau."
    ],
    [Phẩm Đạo],
  ),
  (
    [
      "Hãy mau làm điều lành, ngăn tâm khỏi điều ác."

      "Ai chậm làm việc lành, tâm họ dễ vui với điều xấu."

      "Nhiều đời sống được định hình bởi những lựa chọn ngắn hằng ngày."
    ],
    [Phẩm Tạp Lục],
  ),
  (
    [
      "Kẻ nói dối đi vào đường dữ; kẻ đã làm mà còn bảo không làm, cả hai đều chịu quả khổ như nhau."

      "Đi đủ lâu trong dối trá, con người không chỉ làm sai mà còn thành một kiểu người tối lại."

      "Nhìn tới điểm cuối của con đường xấu là cách tự cứu mình sớm."
    ],
    [Phẩm Địa Ngục],
  ),
  (
    [
      "Như voi giữa trận chịu tên bắn, ta cũng sẽ chịu lời mắng chửi."

      "Sức mạnh quý nhất không phải là quăng bật lại, mà là đứng vững mà không loạn."

      "Một tâm đã luyện chịu được điều khó lâu hơn cơn bốc đồng chịu nổi."
    ],
    [Phẩm Voi],
  ),
  (
    [
      "Ai bị ái dục thắng phục, sầu não lớn dần như cỏ mọc mạnh sau mùa mưa."

      "Chặt lá mà không đụng rễ thì dây trói sẽ mọc lại."

      "Muốn nhẹ mình phải nhìn thẳng vào cái đói đang nuôi ham muốn."
    ],
    [Phẩm Ái Dục],
  ),
  (
    [
      "Hãy làm nhẹ chiếc thuyền này; khi thuyền nhẹ, ngươi sẽ đi nhanh."

      "Bỏ tham và sân, ngươi sẽ đến gần bờ kia."

      "Con đường tu tập tiến bằng bớt nặng đi, không chỉ bằng thêm quyết tâm."
    ],
    [Phẩm Tỳ Kheo],
  ),
  (
    [
      "Không phải vì bện tóc, vì dòng họ hay vì sinh ra trong gia tộc mà thành bà-la-môn."

      "Ai có sự thật và chính hạnh, người ấy mới thanh tịnh."

      "Phẩm giá của một người được đo bằng điều họ sống ra, không bằng chiếc nhãn họ mang."
    ],
    [Phẩm Bà La Môn],
  ),
)

#let pc-trich-note-for(number) = {
  if number >= 1 and number <= _pc-trich-notes.len() {
    _pc-trich-notes.at(number - 1)
  } else {
    none
  }
}
