#let _pc-truyen-notes = (
  [
    *Hai người cùng nhận một lời xúc phạm.* Một người ôm hận suốt nhiều ngày, người kia dừng lại nhìn tâm mình rồi buông xuống. Cùng một biến cố nhưng hai đời sống rẽ hai hướng chỉ vì tâm đi trước khác nhau. Đó là cánh cửa tự nhiên nhất để bước vào phẩm *Song Yếu*.

    *Bánh xe lăn theo vết chân con bò kéo xe.* Nếu người ta nói hay làm với tâm ý ô nhiễm, sự đau khổ sẽ theo sau họ sát sao như bánh xe lăn theo con vật kéo. Ngược lại, nói hay làm với tâm ý thanh tịnh, hạnh phúc sẽ theo sau như bóng không rời hình.
  ],
  [
    *Người canh đèn giữa đêm.* Cả nhà đều ngủ, chỉ một người còn thức để giữ ngọn đèn khỏi tắt. Nếu anh chợp mắt, bóng tối sẽ nuốt cả căn nhà. Hình ảnh ấy diễn rất đúng tinh thần *Không Phóng Dật*: tỉnh và giữ mình trong cái nhỏ mới là gốc của đường dài.

    *Hòn đảo giữa dòng nước lớn.* Nước lụt cuốn trôi mọi thứ, chỉ có người tự xây cho mình một hòn đảo của sự tỉnh thức mới không bị chìm đắm. Người trí biết lấy sự không buông lung làm tài sản quý giá nhất, để đứng vững trước mọi xô đẩy của đời.
  ],
  [
    *Người thợ nắn mũi tên.* Ông ngồi kiên nhẫn uốn từng chút một cho thân tên thẳng lại. Tâm con người trong phẩm này cũng được nhìn như thế: nếu không luyện, nó cong và chạy; nếu biết chăm, nó dần ngay lại.

    *Con cá bị quăng lên bờ khô.* Giống như con cá giãy giụa khi lìa khỏi nước, tâm con người cũng rung động, hoảng loạn khi cố thoát khỏi cảnh giới của ác ma. Muốn thoát khổ, phải khéo léo chế ngự cái tâm hay chao đảo và khó nắm bắt này.
  ],
  [
    *Con ong lấy mật mà không làm rách cánh hoa.* Nó đến, lấy phần tinh nhất rồi bay đi, để bông hoa vẫn còn nguyên. Đây là mẫu chuyện rất đẹp cho phẩm *Hoa*: sống giữa đời mà không làm tổn thương, học nhiều mà không dẫm nát điều mình chạm vào.

    *Kết những vòng hoa đẹp.* Người thợ khéo biết chọn những bông hoa tươi thắm nhất để kết thành tràng hoa dâng lên cúng dường. Bậc trí giả cũng vậy, khéo léo chọn lựa những thiện pháp tinh túy giữa rừng nhân gian để làm đẹp cho cuộc đời mình.
  ],
  [
    *Người chăn bò đếm bò cho kẻ khác.* Miệng anh đọc vanh vách số lượng, nhưng đàn bò chẳng con nào là của mình. Kẻ ngu trong Pháp Cú cũng vậy: có thể nhắc nhiều lời hay mà chẳng sống được điều nào.

    *Kẻ ngu tự nhận mình có trí.* Người thiếu hiểu biết mà tự biết mình thiếu hiểu biết, nhờ vậy còn có cơ hội thành người trí. Nhưng kẻ ngu bẩm sinh lại luôn vỗ ngực tự xưng mình là bậc hiền tài, đó mới thực sự là kẻ vô phương cứu chữa.
  ],
  [
    *Người dẫn đường chỉ chỗ lún.* Bạn tốt không phải lúc nào cũng nói dễ nghe; có khi họ chỉ đúng chỗ ta đang sa mà ta không muốn nhìn. Hình ảnh ấy mở thẳng vào phẩm *Hiền Trí*: gặp người dám sửa mình là gặp một kho báu chứ không phải một kẻ làm phiền.

    *Tảng đá kiên cố trước gió bão.* Dù gió thổi từ bốn phương tám hướng, tảng đá lớn vẫn không mảy may nhúc nhích. Bậc trí giả cũng thế, dù nghe muôn lời khen ngợi hay chê bai, tâm họ vẫn tĩnh tại và không hề xao động.
  ],
  [
    *Chim bay qua trời không để lại dấu.* Người đã bớt sạch chấp trước cũng thế: họ đi giữa đời nhưng không còn để lại những đường cào tham, sân, hơn, thua trên mọi việc. Đó là mẫu hình sáng nhất của phẩm *A La Hán*.

    *Người thoát khỏi lưới của ma.* Không còn bị trói buộc bởi tham ái hay dính mắc vào ăn uống, họ sống rỗng rang tự tại. Đường đi của bậc Thánh nhân hoàn toàn vắng lặng và không thể dò tìm, giải thoát khỏi mọi vướng bận trần gian.
  ],
  [
    *Một câu đánh thức còn hơn ngàn câu làm ồn.* Có người nghe vô số lời hay mà lòng vẫn ngủ. Có người chỉ nghe đúng một câu đúng lúc rồi đổi cả cách sống. Truyện ấy đi vào phẩm *Ngàn* rất tự nhiên: số lượng không thay thế được chiều sâu.

    *Tế lễ trăm năm không bằng khoảnh khắc.* Dù có dâng cúng thần linh liên tục trong cả thế kỷ, cũng không sánh bằng một sát-na tôn kính người đã tự tu luyện và chiến thắng bản tâm. Phẩm chất của sự tịnh hóa vượt xa mọi nghi thức cúng bái.
  ],
  [
    *Chiếc chum đầy lên bằng từng giọt.* Người làm điều ác nhỏ thường tự an ủi rằng có đáng gì đâu. Nhưng từng giọt một rồi chum đầy, đến lúc nhìn lại thì thói quen xấu đã thành tính. Đây là mẫu truyện chuẩn của phẩm *Ác*.

    *Quả báo muộn nhưng chắc chắn.* Kẻ ác tưởng mình may mắn khi hạt giống ác chưa nảy mầm, nhưng khi quả báo trổ ra, họ chỉ còn cách nuốt trọn vị đắng của nó. Nghiệp quả có thể đến trễ, nhưng không bao giờ vắng mặt.
  ],
  [
    *Người cầm roi chợt nhớ mình cũng sợ đau.* Khi đặt mình vào thân của kẻ bị đánh, bàn tay đang giận dữ tự nhiên chậm lại. Phẩm *Hình Phạt* mở ra từ trực giác rất đơn giản mà rất khó sống này: ai cũng sợ đau, ai cũng sợ mất.

    *Gieo rắc bạo lực thu về sầu muộn.* Kẻ dùng đao trượng và bạo lực để mưu cầu hạnh phúc cho riêng mình sẽ vĩnh viễn không tìm thấy bình yên. Vì mọi sự tổn thương gây ra cho kẻ khác cuối cùng sẽ dội lại trên chính thân phận mình ở đời sau.
  ],
  [
    *Chiếc xe cũ cứ kêu cót két khi đi đường.* Người trẻ thấy thân mình bền nên quên già, nhưng thân xác rồi cũng như chiếc xe kia: từng phần mòn dần. Phẩm *Già* mời ta nhìn sự thật ấy sớm để sống tỉnh hơn chứ không để buồn hơn.

    *Lớp da ngoài và vết thương bên trong.* Thân thể con người dẫu có được tô vẽ, mặc lụa là đẹp đẽ đến đâu, bên trong vẫn là tập hợp của xương thịt, bệnh tật và sự già nua rình rập. Chấp trước vào cái vỏ bọc này là nguồn cơn của mọi phiền toái.
  ],
  [
    *Người thắng cả làng nhưng không thắng nổi mình.* Anh có thể lớn tiếng với người khác, tranh hơn đủ điều, nhưng vẫn bó tay trước chính cơn nóng và sự lười của bản thân. Mẫu truyện ấy mở thẳng vào phẩm *Tự Ngã*: chỗ khó nhất và thật nhất là tự mình rèn mình.

    *Chiến thắng vĩ đại nhất.* Có thể chinh phục hàng ngàn vạn đội quân trên chiến trường đẫm máu, nhưng chiến công ấy vẫn chưa phải là tối thượng. Kẻ nào tự chinh phục được chính mình, kẻ đó mới là chiến binh vĩ đại nhất.
  ],
  [
    *Đứa trẻ đuổi theo cầu vồng.* Nó tưởng chỉ cần chạy thêm chút nữa là nắm được màu sắc trước mặt, nhưng thứ ấy cứ lùi mãi. Phẩm *Thế Gian* nhìn nhiều thứ đời người cũng như vậy: đẹp, mê, gần tay mà rất dễ là ảo ảnh.

    *Nhìn đời như bọt nước.* Ai có khả năng nhìn thấu thế gian chỉ là một ảo ảnh hư vờ, là bọt nước thoắt còn thoắt mất, người đó sẽ không còn bị Tử thần lùng sục. Sự thức tỉnh bắt đầu từ việc không nắm víu vào những thứ vốn dĩ vô thường.
  ],
  [
    *Người bị chửi mà vẫn bình thản hỏi lại: món quà không nhận thì thuộc về ai?* Một bà-la-môn mắng Phật, nhưng Ngài chỉ nhẹ nhàng trả lại câu hỏi ấy. Giai thoại này quá đẹp để không đặt ở đầu phẩm *Phật*: sự giác ngộ hiện ngay trong cách đứng trước xúc phạm.

    *Hạnh phúc từ sự xuất hiện của Thế Tôn.* Mọi niềm vui thế gian đều chóng tàn, nhưng sự xuất hiện của chư Phật, lời thuyết pháp về Đạo giải thoát và sự hòa hợp của tăng đoàn mang lại niềm hạnh phúc vi diệu và bền vững nhất.
  ],
  [
    *Người sống yên giữa làng đang cãi nhau.* Quanh mình đầy tiếng hơn thua, nhưng người ấy vẫn giữ được một nhịp trong không đứt gãy. Đó là mẫu truyện hợp nhất cho phẩm *An Lạc*: hạnh phúc không luôn đợi hoàn cảnh sạch hẳn rồi mới bắt đầu.

    *Thong dong giữa người đầy thù hận.* Xung quanh ai cũng ôm lòng oán kết và bệnh hoạn vì tham sân, ta vẫn tự tại bước đi mà không vướng mầm bệnh tật. Sống thanh thản giữa biển người phiền não là cảnh giới an lạc tuyệt vời nhất.
  ],
  [
    *Dây leo phủ kín gốc cây.* Ban đầu chỉ một sợi mảnh, nhưng để lâu nó quấn chằng chịt đến mức chính thân cây không còn thở thoáng nữa. Phẩm *Ái* nhìn lòng chấp cũng như vậy: cái dính nhỏ không nhận ra sớm rất dễ thành dây trói lớn.

    *Từ ái luyến sinh ra sợ hãi.* Càng yêu thương bám víu nhiều bao nhiêu, nỗi sợ mất mát và sầu muộn càng lớn bấy nhiêu. Người dứt bỏ được sự dính mắc tình cảm thế gian, bước đi một cách rỗng rang, không còn gì để phải lo sợ.
  ],
  [
    *Người nóng giận ném than vào người khác.* Than chưa kịp tới tay đối phương thì tay mình đã bỏng trước. Cảnh rất quen ấy mở vào phẩm *Phẫn Nộ* gần như không cần giải thích thêm: thắng cơn giận là cứu chính mình trước.

    *Lấy thiện báo ác.* Lấy sự ôn hòa để dập tắt cơn phẫn nộ, lấy từ bi để hóa giải điều ác, lấy sự bố thí để thắng kẻ keo kiệt, lấy lời chân thật để đập tan điều dối trá. Đó là cách chiến thắng mà không cần phải dùng đến vũ lực hay cãi vã.
  ],
  [
    *Người thợ vàng gột từng chút cặn đen.* Không ai làm vàng sáng chỉ bằng một lần chà xát, mà phải bền bỉ loại đi lớp nọ tới lớp kia. Phẩm *Cấu Uế* cũng nói về việc làm sạch nội tâm và nếp sống theo cách nhỏ mà đều như thế.

    *Cạo đầu nhưng tâm vẫn đục.* Một người bề ngoài khoác áo tu sĩ, nhưng bên trong vẫn đầy rẫy sự tham lam và ác ý thì chẳng thể gọi là Sa môn. Chỉ khi rũ sạch cấu uế của nội tâm, hình thức bên ngoài mới mang ý nghĩa trọn vẹn.
  ],
  [
    *Ông lão tóc bạc nhưng xử việc thiên lệch.* Người đời dễ nhầm tuổi tác hoặc lời nói nhiều với chỗ đứng của chân lý. Phẩm *Pháp Trụ* nhắc bằng mẫu người như vậy rằng công chính không đến từ hình thức, mà từ tâm cân, lời thật, việc thẳng.

    *Kẻ nói nhiều không hẳn là bậc trì pháp.* Dù không nghe nhiều học rộng, nhưng người luôn sống đúng theo Đạo, hành động chuẩn mực và không buông lung, kẻ đó mới thực sự gìn giữ và mang Chánh pháp trong mình.
  ],
  [
    *Người đứng trước ngã ba mà chỉ mãi ngắm biển chỉ đường.* Ông nói rất hay về lối nào đúng nhưng không bước nổi bước nào. Đó là mẫu truyện thích hợp nhất để mở phẩm *Đạo*: con đường chỉ là con đường khi đã đi.

    *Bát Chính Đạo và sự nỗ lực cá nhân.* Như Lai chỉ là người chỉ đường, còn bước chân đi là của chính chúng ta. Giữa muôn ngàn lối rẽ, Bát Chính Đạo là con đường duy nhất để rũ bỏ đau khổ, nhưng nó đòi hỏi sự thực hành chứ không phải đứng nhìn.
  ],
  [
    *Người lính giữ thành không ngủ gật một khắc.* Thành có thể mất không phải vì trận công lớn, mà vì một lúc lơi canh nhỏ. Phẩm *Tạp Lục* gom nhiều lời nhắc rải rác, và hình ảnh giữ thành là chiếc neo tốt để nhớ: đời hỏng rất hay từ các khe nhỏ.

    *Buông niềm vui nhỏ để nhận sự lớn lao.* Kẻ khôn ngoan biết rũ bỏ những hoan lạc vụn vặt nhất thời để theo đuổi sự an tịnh và giải thoát rộng lớn hơn. Muốn ôm trọn bầu trời thì phải thôi không tiếc nuối một viên sỏi dưới chân.
  ],
  [
    *Mật ngọt trên lưỡi rồi hóa đắng trong ruột.* Có việc mới làm tưởng như chẳng ai biết, còn đem lại lợi ích rất nhanh, nhưng quả của nó lại đến muộn và nặng. Đây là cánh cửa đúng cho phẩm *Địa Ngục*: hậu quả của sai trái thường chậm mà chắc.

    *Kẻ chối cội nguồn tội lỗi.* Người nói dối làm điều ác rồi lại mở miệng thanh minh "tôi không làm", sau cùng rồi cũng sẽ bị chính nghiệp lực của mình cuốn thẳng vào cõi khổ. Tự lừa mình dối người là con đường dốc nhanh nhất đi xuống địa ngục.
  ],
  [
    *Con voi trận chịu tên mà vẫn đứng vững.* Không phải vì nó không đau, mà vì nó đã được luyện để không hoảng. Phẩm *Voi* dùng đúng mẫu hình ấy để nói về sức chịu đựng, sự thuần phục và khả năng mang việc khó mà không loạn.

    *Sự điều phục chính mình.* Dư luận và lời phỉ báng ở đời như làn mưa cung tên bay tới tấp giữa sa trường. Chỉ những bậc đại trí đã tự thuần hóa bản tâm mới có thể vững vàng hứng chịu mà không sinh tâm thù hận hay hoảng loạn.
  ],
  [
    *Người chặt mãi lá mà quên gốc dây leo.* Cây tưởng đã gọn, ít lâu sau dây leo lại trùm kín hơn trước vì rễ vẫn còn nguyên. Phẩm *Ái Dục* nhấn đúng chỗ đó: muốn nhẹ mình phải đụng vào gốc ham muốn chứ không chỉ cắt biểu hiện bên ngoài.

    *Con nhện kẹt trong mạng lưới của chính nó.* Tự mình nhả tơ giăng lưới rồi lại bị mắc kẹt vào chính chiếc rập ấy. Người đắm chìm trong ái dục cũng tự tạo ra vô số hệ lụy và bám víu, đến khi ngoảnh lại đã không còn đường thoát.
  ],
  [
    *Người chèo đò vứt bớt đá khỏi thuyền.* Thuyền nhẹ hơn thì mới sang được bờ bên kia. Phẩm *Tỳ Kheo* cũng nhìn sự tu tập như thế: bớt dính, bớt nặng, bớt phung phí tâm lực thì đường đi mới sáng dần.

    *Giữ vững lục căn.* Người biết kiểm soát mắt không nhìn bậy, tai không nghe bậy, thân không làm bậy, ý không vọng tưởng – giải thoát mình khỏi sự lôi kéo của ngoại cảnh. Đó mới thật là một Tỳ Kheo bước đi trong sự tự do tuyệt đối.
  ],
  [
    *Người quý tộc kiêu hãnh gặp một bậc bình thản.* Ông tưởng dòng giống làm nên phẩm giá, nhưng rồi phải nhận ra chỗ cao quý thật nằm ở việc đã thắng mình và bớt hại người tới đâu. Đây là truyện mẫu sáng nhất để mở phẩm *Bà La Môn*.

    *Sự trong sạch không nằm ở mái tóc bện.* Không phải sinh ra trong gia tộc quyền quý hay khoác lên mình hình thức tu hành khổ hạnh thì tự khắc trở nên cao thượng. Kẻ sống không tham chấp, tâm hoàn toàn thanh tịnh mới đích thực là bậc chân tu cao quý.
  ],
)

#let pc-truyen-note-for(number) = {
  if number >= 1 and number <= _pc-truyen-notes.len() {
    _pc-truyen-notes.at(number - 1)
  } else {
    none
  }
}
