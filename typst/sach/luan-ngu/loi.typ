// ═══════════════════════════════════════════════════════════
// CHÙM NGỮ LỤC MỞ THIÊN — Luận Ngữ
// Mỗi thiên vài lời then chốt để giữ đúng giọng ngữ lục của sách
// ═══════════════════════════════════════════════════════════

#let _ln-loi-notes = (
  (
    [
      "Học mà thường ôn tập, chẳng phải là điều vui sao?"

      "Có bạn từ xa tới, chẳng phải là điều đáng mừng sao?"

      "Người không ai biết đến mà không giận, chẳng phải là quân tử sao?"
    ],
    [Thiên Học Nhi],
  ),
  (
    [
      "Dẫn người bằng đức thì họ như sao Bắc Đẩu: đứng yên mà các sao khác tự hướng về."

      "Ôn điều cũ mà hiểu điều mới, người ấy có thể làm thầy."

      "Mười lăm tuổi chí ở học; ba mươi tuổi đứng vững; bốn mươi tuổi bớt nghi; năm mươi biết mệnh."
    ],
    [Thiên Vi Chính],
  ),
  (
    [
      "Người không có nhân thì dùng lễ sao được?"

      "Người không có nhân thì dùng nhạc sao được?"

      "Nghi thức đẹp mà thiếu lòng kính, cái đẹp ấy chỉ còn là cái vỏ."
    ],
    [Thiên Bát Dật],
  ),
  (
    [
      "Ở gần điều nhân, con người bớt lệch."

      "Người quân tử hiểu điều phải; kẻ tiểu nhân chỉ nhìn điều lợi."

      "Giàu sang mà trái nghĩa, với ta như mây nổi."
    ],
    [Thiên Lý Nhân],
  ),
  (
    [
      "Nghe lời người chưa đủ; còn phải xem việc người làm."

      "Biết người không ở chỗ tin lời ngọt, mà ở chỗ nhìn họ qua việc khó."

      "Thấy chỗ hay của người mà không ghen, đó cũng là một cách học."
    ],
    [Thiên Công Dã Tràng],
  ),
  (
    [
      "Biết chưa bằng thích; thích chưa bằng vui."

      "Người trí vui nước; người nhân vui núi."

      "Chất phác quá thành thô, văn vẻ quá thành hư; hòa được hai bên mới nên người."
    ],
    [Thiên Ung Dã],
  ),
  (
    [
      "Ta chỉ thuật lại, không tự bày đặt; tin và yêu điều xưa."

      "Ba người cùng đi, ắt có người là thầy ta."

      "Học không biết chán, dạy người không biết mệt."
    ],
    [Thiên Thuật Nhi],
  ),
  (
    [
      "Có thể đoạt soái một đạo quân, không thể đoạt chí của kẻ sĩ."

      "Người lớn ở chỗ nhường điều mình có thể giữ."

      "Đức dày thì lời ít mà sức cảm hóa sâu."
    ],
    [Thiên Thái Bá],
  ),
  (
    [
      "Đến rét rồi mới biết tùng bách là loài chịu lạnh sau cùng."

      "Người học đạo không sợ nghèo, chỉ sợ chí bị mòn."

      "Điều bền của con người lộ ra trong mùa khó."
    ],
    [Thiên Tử Hãn],
  ),
  (
    [
      "Bước vào chỗ nghiêm thì cung kính, ra với người già thì hòa nhã."

      "Ăn, ở, nói, cười đều có chừng mực."

      "Chỗ học lớn thường lộ ra ngay trong việc rất nhỏ."
    ],
    [Thiên Hương Đảng],
  ),
  (
    [
      "Người trước vào đạo có chỗ chậm mà chắc; người sau vào đạo có chỗ nhanh mà khéo."

      "Dùng người phải biết khí chất từng người."

      "Dạy học không phải xếp ai cũng cùng một nhịp."
    ],
    [Thiên Tiên Tiến],
  ),
  (
    [
      "Thắng mình và trở về lễ là nhân."

      "Điều gì không hợp lễ thì chớ nhìn, chớ nghe, chớ nói, chớ làm."

      "Điều mình không muốn, đừng làm cho người."
    ],
    [Thiên Nhan Uyên],
  ),
  (
    [
      "Danh không chính thì lời chẳng thuận; lời chẳng thuận thì việc khó nên."

      "Người ngay thì đứng thẳng giữa việc đời."

      "Biết rồi mà không làm, cái biết ấy còn nông."
    ],
    [Thiên Tử Lộ],
  ),
  (
    [
      "Người quân tử hổ thẹn vì lời nhiều hơn việc làm."

      "Gặp thời khó, giữ mình cho ngay còn quý hơn giữ miệng cho khéo."

      "Người xưa học vì sửa mình; người nay dễ học vì để người khác biết."
    ],
    [Thiên Hiến Vấn],
  ),
  (
    [
      "Điều mình không muốn, chớ đem tới cho người."

      "Người quân tử cầu ở mình; kẻ tiểu nhân cầu ở người."

      "Đường xa không ngại, chỉ ngại chí mình nghiêng."
    ],
    [Thiên Vệ Linh Công],
  ),
  (
    [
      "Không lo ít của, chỉ lo chia không đều; không lo nghèo, chỉ lo lòng người không yên."

      "Bạn có ba điều lợi và cũng có ba điều hại."

      "Nhà gần loạn thường bắt đầu từ chỗ thân cận."
    ],
    [Thiên Quý Thị],
  ),
  (
    [
      "Tính người gần nhau; do thói quen mà xa nhau."

      "Chỉ bậc rất trí và rất ngu là khó đổi."

      "Ngày tháng trôi nhanh, sao không học để tự dựng mình?"
    ],
    [Thiên Dương Hóa],
  ),
  (
    [
      "Khi đạo không còn được dùng, có người đi, có người ở, có người im mà giữ."

      "Phụng sự điều sai không phải là trung."

      "Giữ mình khỏi đục cũng là một cách giữ đạo."
    ],
    [Thiên Vi Tử],
  ),
  (
    [
      "Học cho rộng, hỏi cho kỹ, nghĩ cho cẩn thận, phân biệt cho sáng, làm cho thực."

      "Lỗi mà không sửa mới thành lỗi thật."

      "Tin bạn nhưng đừng bỏ mất điều phải."
    ],
    [Thiên Tử Trương],
  ),
  (
    [
      "Người cầm quyền phải làm sáng đức rồi mới mong người tin."

      "Ban điều lợi cho dân mà không làm dân mệt, đó là trị."

      "Ở chỗ cao mà không kiêu, dùng người mà không khinh, đó mới là lớn."
    ],
    [Thiên Nghiêu Viết],
  ),
)

#let ln-loi-note-for(number) = {
  if number >= 1 and number <= _ln-loi-notes.len() {
    _ln-loi-notes.at(number - 1)
  } else {
    none
  }
}
