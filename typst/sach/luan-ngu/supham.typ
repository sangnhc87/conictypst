// ═══════════════════════════════════════════════════════════
// GÓC NHÌN SƯ PHẠM — Luận Ngữ
// Mỗi thiên một ghi chú cho giáo viên Toán phổ thông
// ═══════════════════════════════════════════════════════════

#let _ln-supham-notes = (
  [
    Luận Ngữ mở bằng niềm vui học và việc ôn lại, nên với lớp Toán, rất đáng dựng một nhịp đầu giờ ngắn mà đều: nhắc lại ý cũ, chữa một lỗi quen, hỏi một câu kiểm tra trí nhớ có hiểu. Học sinh sẽ bớt xem ôn tập là cực hình nếu cảm được nó làm mình vững lên từng ngày.
  ],
  [
    Thiên này nhắc người dạy rằng quản lớp bằng đức và sự nhất quán bền hơn quản lớp bằng quát mắng. Nếu thầy cô đúng giờ, lời nói chuẩn, cách chữa bài công bằng, học sinh sẽ dần đi theo nề nếp ấy. Trong dạy Toán, uy tín sư phạm là một loại "sao Bắc Đẩu".
  ],
  [
    Routines như cách trình bày, cách ghi điều kiện, cách phát biểu trước lớp đều cần; nhưng nếu lớp chỉ còn hình thức mà mất tôn trọng và lòng thật, mọi thứ sẽ rỗng. Hãy giữ nghi thức đủ chặt để nâng người học lên, chứ đừng dùng nó như chiếc roi của cái tôi.
  ],
  [
    Khi lớp chỉ thưởng cho tốc độ, học sinh sẽ học cách săn điểm hơn là học cách giữ điều phải. Thiên này gợi người dạy tạo những khoảnh khắc khen sự cẩn trọng, sự trung thực khi nhận sai và sự công bằng trong hợp tác. Môi trường học quyết định rất mạnh học sinh sẽ lớn thành kiểu người nào.
  ],
  [
    Giáo viên Toán không nên đóng đinh học sinh bằng ấn tượng đầu. Nên quan sát các em ở nhiều tình huống: làm bài cá nhân, giải thích miệng, sửa bài cho bạn, hỏi lại khi chưa hiểu. Đọc người qua một lần kiểm tra quá hẹp thì dễ lỡ mất nhiều năng lực đang còn kín.
  ],
  [
    Từ "biết" sang "thích", rồi từ "thích" sang "vui" là cả một đường dài của dạy học. Với môn Toán, muốn học sinh đi xa, không thể chỉ đưa kỹ thuật; cần cho các em nếm cảm giác bài sáng lên, lời giải gọn lại, cấu trúc hiện ra. Niềm vui trí tuệ là động cơ mạnh nhất mà trường học thường làm yếu đi.
  ],
  [
    Thiên này nhắc rất mạnh rằng người dạy vẫn phải là người học. Một giáo viên Toán khỏe nghề thường còn giữ thói quen xem lại lời giải của mình, học thêm cách trình bày mới và nhận học sinh cũng có thể dạy mình thấy chỗ tối. Lớp học bền khi thầy cô không đóng khung mình là người đã xong phần học.
  ],
  [
    Có những học sinh chưa mạnh điểm số nhưng lại giữ một cái chí rất đáng quý. Đừng vô tình bẻ gãy chí ấy bằng giễu cợt hoặc so sánh thiếu tinh tế. Nhiều khi việc quan trọng nhất của người dạy không phải là giải thêm một bài, mà là giữ cho lòng ham học của một em không tắt.
  ],
  [
    Khó khăn là nơi lộ phẩm chất. Vì vậy, với bài khó, đừng vội giải cứu quá sớm; hãy cho học sinh một quãng cố gắng thật sự rồi mới mở khóa nhỏ. Cái các em mang đi từ một giờ Toán không chỉ là đáp án, mà còn là trải nghiệm mình có thể đứng lại trước cái khó mà không gãy.
  ],
  [
    Thiên này nói bằng đời sống rất nhỏ, và đó là lời nhắc mạnh cho người dạy: bảng viết gọn, cách chào lớp, cách nghe học sinh nói hết câu, cách phát bài, tất cả đều đang dạy. Học sinh không chỉ học toán từ nội dung, mà còn học từ phong thái và nết sinh hoạt của lớp.
  ],
  [
    Một lớp Toán mạnh không thể chạy bằng một nhịp cho mọi người. Có em cần chậm để chắc, có em cần nhanh để không chán, có em cần được gọi tên đúng chỗ mạnh. Phân hóa không phải chia cấp bậc, mà là cho mỗi em một đường tiến bộ thực.
  ],
  [
    Tự thắng mình và quay về kỷ luật là chuyện rất thật trong lớp Toán: bớt nói chen, bớt cẩu thả, bớt làm ẩu để kịp nộp, bớt nhìn bài bạn khi hoảng. Người dạy nên xây những nguyên tắc lớp đơn giản nhưng giữ rất đều. Nhân cách học tập không lớn lên nhờ lời khuyên chung, mà nhờ vô số lần tự giữ trong cái nhỏ.
  ],
  [
    Với môn Toán, chính danh trước hết là gọi đúng sự việc: giả thiết nào, kết luận nào, điều kiện nào, phương pháp nào. Khi ngôn ngữ lớp học mơ hồ, tư duy cũng mơ hồ theo. Giáo viên càng rèn học sinh nói chính xác, lớp càng bớt cãi nhau vì hiểu sai và bớt sai vì gọi lầm tên vấn đề.
  ],
  [
    Học vì sửa mình khác hẳn học để phô diễn. Khi chữa bài, hãy để tiêu chuẩn nằm ở độ hiểu, độ chặt, độ thành thật với chỗ chưa ra, thay vì ở màn thể hiện ồn ào. Học sinh rất dễ nhiễm văn hóa "nói hay hơn làm" nếu lớp thường thưởng lời hơn thưởng việc.
  ],
  [
    Một nguyên tắc nhỏ của thiên này có thể thành nguyên tắc lớn của lớp học: điều mình không muốn nhận từ người khác thì đừng ném cho bạn. Từ việc chê bai, cắt lời, cười khi bạn sai cho tới việc giấu cách làm để giữ lợi thế, tất cả đều có thể được sửa bằng nguyên tắc ấy. Nó giúp lớp Toán bớt độc và bớt sợ.
  ],
  [
    Nhiều trục trặc của lớp không bắt đầu từ bài kiểm tra, mà từ những lệch nhỏ trong công bằng, phân công và quan hệ gần. Thiên này nhắc người dạy giữ mắt rất gần: nhóm bạn nào đang kéo nhau xuống, ai đang bị bỏ ngoài cuộc, quy tắc nào đang bất lợi cho người yếu. Chỗ gần yên thì chỗ xa mới yên.
  ],
  [
    Học sinh không cách nhau quá xa ở xuất phát; họ cách nhau nhiều hơn ở thói quen. Vì vậy, thay vì than năng lực bẩm sinh, người dạy nên đầu tư mạnh vào routine: ghi điều kiện, tự kiểm, hỏi lại, ôn ngắn, sửa lỗi cũ. Rất nhiều khoảng cách trong Toán thực ra là khoảng cách của nếp học.
  ],
  [
    Thiên này rất hợp để nhắc về sự chính trực trong trường học. Có những lúc đi theo số đông, chạy thành tích hoặc làm đẹp bề mặt là dễ hơn giữ cái đúng. Người dạy Toán cần cho học sinh thấy rằng không gian học phải có chỗ cho người muốn giữ thẳng lưng, kể cả khi điều ấy không tiện.
  ],
  [
    Học cho rộng nhưng phải làm cho thực. Với Toán, điều đó có nghĩa là đừng chất thêm tài liệu nếu các em còn chưa tiêu hóa được cái đã học. Thay vào đó, hãy tập cho học sinh hỏi kỹ, làm chậm, sửa thật và biến cái hiểu mỏng thành cái hiểu có thể dùng lại.
  ],
  [
    Cuối cùng, Luận Ngữ kéo mọi chuyện về chỗ gánh trách nhiệm mà không kiêu. Với người dạy, đó là nghệ thuật dùng quyền vừa đủ: giữ chuẩn, bảo vệ lớp, giao việc, nâng người khác lên mà không làm họ thấy mình bé đi. Một giờ Toán tốt cũng là một bài học nhỏ về lãnh đạo tử tế.
  ],
)

#let ln-supham-note-for(number) = {
  if number >= 1 and number <= _ln-supham-notes.len() {
    _ln-supham-notes.at(number - 1)
  } else {
    none
  }
}
