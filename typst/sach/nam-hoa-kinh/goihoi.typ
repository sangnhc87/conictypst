// ═══════════════════════════════════════════════════════════
// CÂU HỎI GỢI ĐÀM THOẠI — Nam Hoa Kinh
// Mỗi thiên 1–2 câu để kéo tư tưởng Trang Tử vào trao đổi với học sinh
// ═══════════════════════════════════════════════════════════

#let _nhk-goihoi-notes = (
  [
    - Trong cùng một bài, em cần "cửa vào" nào để không bị ngợp ngay từ đầu?
    - Theo em, công bằng trong lớp Toán là làm cùng một việc hay ai cũng có đường tiến bộ?
  ],
  [
    - Nếu một bài có hai cách giải khác nhau nhưng đều đúng, em ưu tiên tiêu chí nào để chọn?
    - Khi thấy cách làm của bạn khác mình, em muốn so sánh điều gì trước tiên?
  ],
  [
    - Trước một bài khó, làm sao để nhận ra "thớ" của bài thay vì lao vào biến đổi ngay?
    - Dấu hiệu nào cho em biết mình nên dừng lại để nhìn cấu trúc trước?
  ],
  [
    - Khi bạn trả lời sai, điều gì giúp bạn ấy nói tiếp được thay vì im luôn?
    - Em muốn thầy cô sửa ngay hay hỏi thêm để em tự thấy chỗ lệch?
  ],
  [
    - Có kiểu năng lực nào trong lớp dễ bị bỏ sót chỉ vì không lộ ra ngoài?
    - Em thấy mình hiểu bài tốt hơn khi viết, nói, vẽ hay thử ví dụ?
  ],
  [
    - Có bài nào em chưa làm được hôm nay nhưng vẫn tin mình sẽ hiểu sau không?
    - Khi bế tắc, điều gì giúp em không vội kết luận rằng mình "không có tố chất"?
  ],
  [
    - Em muốn thầy cô gợi ở mức nào để còn tự nghĩ được?
    - Khi nào một gợi ý trở nên quá nhiều?
  ],
  [
    - Điều gì trong đề bài hay lời giải khiến em rối dù không thật cần?
    - Làm sao để giữ lõi của một bài mà không bị chìm trong phần thừa?
  ],
  [
    - Em có thích được tự chọn cách làm trong một vài bài không? Vì sao?
    - Kỷ luật nào giúp em học tốt hơn mà không thấy bị bó quá chặt?
  ],
  [
    - Điểm số nên phản ánh điều gì ngoài đáp án cuối?
    - Em thấy một bài kiểm tra công bằng khi nào?
  ],
  [
    - Có khi nào khoảng im lặng tự nghĩ giúp em hơn một lời giảng thêm?
    - Em cần bao lâu để tự thử trước khi muốn được gợi?
  ],
  [
    - Một lớp học khiến em yên tâm thường có nhịp nào lặp lại?
    - Khi lớp ổn định hơn, em có dám làm sai và sửa sai hơn không?
  ],
  [
    - Nếu thầy cô vắng một buổi, những thói quen nào giúp em vẫn tự học được?
    - Em muốn có một quy trình tự soát bài như thế nào?
  ],
  [
    - Có kỹ thuật nào em thấy "đến đúng lúc" nên hiểu ngay hơn không?
    - Làm sao nhận ra mình chưa sẵn sàng học tiếp một bước khó hơn?
  ],
  [
    - Theo em, học Toán bền hơn nhờ cố quá sức hay nhờ làm đúng cách?
    - Khi nào sự chăm chỉ biến thành tự làm mệt mình?
  ],
  [
    - Điểm mạnh tự nhiên của em trong Toán là gì: hình, số, biến đổi, nói ý tưởng hay kiên nhẫn?
    - Làm sao dùng điểm mạnh đó để kéo điểm yếu đi lên?
  ],
  [
    - Cùng một bài, nghe thêm một cách giải khác giúp em thấy gì mới?
    - Có khi nào em tự tin quá sớm rồi phát hiện mình nhìn còn hẹp không?
  ],
  [
    - Niềm vui thật của em trong giờ Toán đến từ lúc nào?
    - Một lần "à ra thế" có đáng nhớ hơn một nửa điểm không? Vì sao?
  ],
  [
    - Luyện đủ tay khác gì với chép nhiều lần mà vẫn không hiểu?
    - Khi nào em thấy một kỹ năng bắt đầu "vào tay" thật sự?
  ],
  [
    - Một khoảng ngồi nghĩ chưa ra có thật sự là lãng phí không?
    - Em muốn lớp học nhìn việc thử sai như thế nào?
  ],
  [
    - Điều gì làm em tin một lời giải của thầy cô hoặc của bạn?
    - Theo em, sự rõ ràng quan trọng thế nào so với sự cao siêu?
  ],
  [
    - Em thích đoán trước hướng đi của bài rồi mới chứng minh không?
    - Khi nào trực giác của em cần được kiểm lại bằng lập luận?
  ],
  [
    - Khi sai liên tục, em muốn tìm lỗi ở bước nào trước?
    - Theo em, chữa từng biểu hiện hay tìm lỗi gốc hiệu quả hơn?
  ],
  [
    - Nếu phải bỏ bớt một việc để học chắc hơn, em sẽ bỏ điều gì?
    - Làm sao biết mình đang bận nhiều mà học không sâu?
  ],
  [
    - Em thấy thế nào khi bị gắn nhãn "yếu Toán" hoặc "chỉ học mẹo"?
    - Nếu mô tả đúng hơn, em muốn người khác nói mình đang vướng ở đâu?
  ],
  [
    - Công nghệ giúp em học tốt hơn ở khâu nào, và làm em lười nghĩ hơn ở khâu nào?
    - Khi dùng máy hoặc AI, em muốn giữ phần suy nghĩ nào cho chính mình?
  ],
  [
    - Một ví dụ đời thường hay một hình ảnh so sánh có giúp em hiểu Toán nhanh hơn không?
    - Em nhớ bài lâu hơn qua công thức hay qua một câu chuyện, một hình ảnh?
  ],
  [
    - Có phải học sinh khá lúc nào cũng cần bị đẩy vào bài khó hơn không?
    - Theo em, phát triển sâu và phát triển nhanh khác nhau thế nào?
  ],
  [
    - Vì sao chép mẫu hoặc học tủ có thể làm mình tưởng là ổn trong khi bên trong rỗng?
    - Một cách kiểm tra nào buộc người học phải hiểu thật hơn?
  ],
  [
    - Ví dụ kiểu nào gần với đời sống của em nhất nên làm Toán bớt xa lạ?
    - Nếu được chọn bối cảnh cho một bài toán, em muốn chọn điều gì?
  ],
  [
    - Khi nói "sai là bình thường", lớp cần làm gì để câu ấy thành thật chứ không phải khẩu hiệu?
    - Em có dám nói ý chưa trọn nếu biết mình không bị cắt ngang quá sớm không?
  ],
  [
    - Em thường biết mình tiến bộ nhờ điểm số hay nhờ tự nhìn cách làm của mình?
    - Nếu tự chấm bản thân hôm nay, em sẽ nhìn vào dấu hiệu nào ngoài điểm?
  ],
  [
    - Sau một chương, em thấy cách giải nào hợp mình nhất và cách nào em còn muốn học thêm?
    - Theo em, vì sao không có một "chìa khóa vạn năng" cho mọi bài toán?
  ],
)

#let nhk-goihoi-note-for(number) = {
  if number >= 1 and number <= _nhk-goihoi-notes.len() {
    _nhk-goihoi-notes.at(number - 1)
  } else {
    none
  }
}
