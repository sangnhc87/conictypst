// ═══════════════════════════════════════════════════════════
// GÓC NHÌN SƯ PHẠM — Nam Hoa Kinh
// Mỗi thiên một ghi chú cho giáo viên Toán phổ thông
// ═══════════════════════════════════════════════════════════

#let _nhk-supham-notes = (
  [
    Trong lớp Toán, đừng lấy vài em bay rất nhanh làm chuẩn đo cả lớp. Với một bài khó, nên chuẩn bị ít nhất hai cửa vào: một câu hỏi khởi động thật cơ bản và một nhánh mở rộng cho học sinh khá giỏi. Công bằng không phải bắt cả lớp bay cùng độ cao, mà là cho mỗi em có đường cất cánh.
  ],
  [
    Với cùng một bài toán, học sinh có thể vào bằng đại số, hình học, bảng biến thiên hay thử số. Khi chữa bài, nên cho hai cách giải đứng cạnh nhau và hỏi lớp: mỗi cách sáng ở đâu, vướng ở đâu. Như vậy học sinh học được phân biệt khác góc nhìn với sai bản chất.
  ],
  [
    Dạy Toán hiệu quả không phải bắt học sinh "húc" vào bài bằng lực, mà giúp các em nhìn ra thớ của bài. Trước khi giải, nên dừng lớp một phút để gạch cấu trúc: đối xứng, điều kiện, dấu hiệu đơn điệu, dạng quen. Khi nhìn ra thớ, các em bớt sợ bài lạ.
  ],
  [
    Khi học sinh trả lời sai, đừng sửa ngay theo phản xạ. Hãy hỏi thêm một câu để lộ giả định ngầm: em đang hiểu điều kiện thế nào, em nghĩ hai đại lượng này liên hệ ra sao. Nhiều lỗi Toán được cứu bằng nghe kỹ trước khi can thiệp.
  ],
  [
    Đừng đánh giá học sinh quá sớm qua chữ xấu, nói chậm hay vẻ ngoài ít nổi bật. Nên tạo vài kiểu "điểm lộ năng lực" khác nhau: giải thích miệng, vẽ hình, nêu ý tưởng, sửa sai cho bạn. Như vậy lớp không chỉ thưởng cho một kiểu thông minh duy nhất.
  ],
  [
    Học Toán luôn có mùa hiểu nhanh và mùa bế tắc. Khi một em mắc kẹt, thay vì chốt "không có tố chất", hãy chỉ rõ em đang kẹt ở bước nào và cho một nhiệm vụ nhỏ để đi tiếp. Cảm giác tiến thêm một nấc giữ học sinh ở lại với môn Toán.
  ],
  [
    Gợi ý quá sớm dễ làm chết mầm suy nghĩ tự thân. Với bài khó, nên cho học sinh một quãng tự vật lộn an toàn trước, rồi chỉ mở đúng một khóa nhỏ thay vì đưa cả hướng giải. Quản lớp tốt là giữ vừa đủ can thiệp để tư duy của các em còn đất mọc.
  ],
  [
    Soạn bài cho học sinh phổ thông nên tránh lớp vỏ rườm rà không phục vụ ý chính. Trước giờ dạy, nên tự hỏi: dòng nào, ký hiệu nào, yêu cầu nào có thể cắt mà ý vẫn sáng hơn. Càng ít nhiễu, năng lực thật của học sinh càng dễ lộ.
  ],
  [
    Kỷ luật trong lớp Toán là cần, nhưng kỷ luật tốt phải giữ được sức tự làm của học sinh. Thỉnh thoảng nên cho các em tự chọn phương pháp trong cùng một bài rồi mới so sánh hiệu quả sau đó. Các em sẽ học được trách nhiệm với lựa chọn, không chỉ học nghe lệnh.
  ],
  [
    Nếu kiểm tra chỉ xoay quanh chống quay cóp và tránh mất điểm, học sinh sẽ tối ưu mẹo hơn tối ưu hiểu. Nên công khai tiêu chí chấm gắn với năng lực thật: đọc đề, lập luận, giữ điều kiện, tự kiểm kết quả. Cách đánh giá nào thưởng cho hiểu thật thì lớp mới học thật.
  ],
  [
    Không phải tiết nào giáo viên nói nhiều hơn thì hiệu quả hơn. Một khoảng im lặng cho học sinh tự đọc đề, tự thử và tự sai thường quý hơn thêm một lượt giảng. Vô vi sư phạm ở đây là biết lui đúng lúc để tư duy của lớp kịp vận hành.
  ],
  [
    Học sinh rất cần một nhịp lớp ổn định: cách vào bài quen, chuẩn trình bày rõ, thái độ bình tĩnh trước lỗi sai. Không cần tiết nào cũng "bùng nổ"; điều nuôi lớp lâu nhất thường là sự bền, ấm và công bằng. Nhịp ổn giúp học sinh dám học thật.
  ],
  [
    Muốn dạy lâu bền, đừng chỉ dựa vào charisma của giáo viên. Hãy xây những quy trình nhỏ học sinh có thể tự bám vào: đọc đề thế nào, thử trường hợp đặc biệt ra sao, kiểm điều kiện ở bước nào, tự soát cuối bài như thế nào. Khi quy trình sống được, lớp mạnh lên kể cả lúc không có thầy cô kèm sát.
  ],
  [
    Toán học cũng có "đúng thời điểm". Một kỹ thuật hay đưa quá sớm sẽ thành áp lực; đưa đúng lúc học sinh đang thiếu nó thì thành cú mở khóa. Người dạy cần nhìn xem lớp đã đủ nền chưa trước khi tăng độ trừu tượng.
  ],
  [
    Đừng biến việc học Toán thành đạo đức chịu khổ. Bài khó là cần, nhưng khó phải đi cùng phương pháp, chia bậc và điểm tựa. Hãy khen sự bền bỉ có cách, đừng vô tình tôn thờ kiểu cày lì rồi kiệt sức.
  ],
  [
    Không phải học sinh nào cũng mạnh ở cùng một cửa. Khi giao bài, nên xen những cơ hội cho trực giác hình, biến đổi đại số, giải thích miệng và phản biện lời giải cùng xuất hiện. Sửa chỗ lệch nhưng vẫn giữ đường mạnh tự nhiên của từng em thì lòng tin với môn Toán mới còn.
  ],
  [
    Với học sinh khá, đôi khi điều cần nhất là đưa các em "ra biển lớn": một cách giải khác đẹp hơn, một định lý rộng hơn, hay một bài sai vì quá tự tin. Còn với cả lớp, nên cho thấy cùng một bài có thể nhìn từ nhiều bờ. Đó là cách dạy khiêm tốn trí tuệ.
  ],
  [
    Nếu lớp chỉ còn điểm số, học sinh sẽ nhanh mỏi với Toán. Hãy giữ lại những khoảnh khắc vui sâu hơn: tự phát hiện quy luật, rút gọn được lời giải, nối được hai mảng kiến thức tưởng rời nhau. Niềm vui hiểu ra một điều bền hơn rất nhiều so với thêm nửa điểm.
  ],
  [
    Muốn học sinh giải gọn và đẹp, không thể bỏ qua giai đoạn luyện đủ để kỹ thuật đi vào tay. Nhưng luyện nên đi cùng câu hỏi nhận dạng mẫu: vì sao bài này dùng được cách ấy, lúc nào thì không dùng nữa. Khi kỹ năng đã ngấm, học sinh mới còn chỗ rảnh để nghĩ chiến lược.
  ],
  [
    Trong dạy Toán, có những thời gian nhìn như vô dụng: ngồi nghĩ, vẽ nháp, thử sai, nói một ý chưa tròn. Đừng dập tắt các khoảng ấy quá nhanh bằng đáp án mẫu. Nếu lớp chỉ công nhận điều gì ra ngay kết quả, phần sâu nhất của tư duy sẽ bị bỏ đói.
  ],
  [
    Học sinh tin giáo viên không chỉ vì thầy cô nói hay, mà vì cảm được độ chắc, độ thật và độ bình tĩnh. Một lời giải đơn giản, rõ và trung thực thường có sức dạy lớn hơn nhiều câu cao siêu. Với môn Toán, khí chất sư phạm cũng là một dạng logic.
  ],
  [
    Dạy Toán không thể chỉ dừng ở công thức và định nghĩa; học sinh còn cần trực giác để ngửi ra bài toán đang đòi hỏi gì. Nhưng trực giác đẹp nhất vẫn phải đi tới chỗ được kiểm chứng bằng lập luận. Nên cho các em cả hai nhịp: đoán trước, rồi làm chặt.
  ],
  [
    Khi một lớp làm sai hàng loạt, đừng vội tăng số lượng bài tập. Hãy tìm lỗi gốc: đọc sai ngôn ngữ đề, quên điều kiện, nhầm bản chất khái niệm hay chỉ bám thói quen cũ. Sửa trúng gốc một lần thường đáng hơn chữa ngọn nhiều lần.
  ],
  [
    Người dạy Toán rất dễ bị kéo vào nhiều việc nhìn đẹp: đội tuyển, phong trào, tài liệu, báo cáo, thành tích bề nổi. Thiên này nhắc mình cân lại để giữ nội lực cho giờ dạy chính. Có những việc biết từ chối mới giữ được bài học không rỗng.
  ],
  [
    Đừng dán nhãn học sinh quá sớm là "yếu Toán" hay "không có tư duy". Thay vì gắn bản chất, hãy mô tả trạng thái hiện tại: em đang vướng ở đọc đề, ở biến đổi, ở bền bỉ hay ở tự tin. Cách gọi đúng mở ra đường sửa; nhãn sai khép đường tiến bộ.
  ],
  [
    Máy tính, GeoGebra, AI, slide hay phiếu học tập đều tốt nếu chúng còn là công cụ. Trong lớp, nên có những đoạn bắt buộc học sinh nghĩ trước khi bấm, đoán trước khi kiểm bằng máy. Công nghệ hỗ trợ tư duy rất mạnh, nhưng không được ngồi lên ghế chủ.
  ],
  [
    Với khái niệm trừu tượng, một ẩn dụ tốt có thể cứu cả tiết học. Nên chuẩn bị vài hình ảnh đúng cửa học sinh đang sống: đường đi, chiếc cân, dòng chảy, trò chơi, chuyển động. Dạy Toán giỏi không chỉ là đúng, mà còn là kể đúng cửa nghe.
  ],
  [
    Không phải học sinh giỏi nào cũng cần bị đẩy vào mọi sân chơi khó nhất. Có em cần chiều sâu hơn tốc độ, có em cần giữ tình yêu với Toán trước khi gánh thêm cạnh tranh. Dạy tốt là biết lúc nào nên thúc và lúc nào nên để học sinh lớn theo khí chất của mình.
  ],
  [
    Nếu học sinh liên tục học tủ, chép mẫu, lách đề mà vẫn qua được, nên xem lại cấu trúc đánh giá chứ không chỉ trách ý thức. Bài kiểm tra cần có phần buộc người học giải thích, biến đổi tình huống hoặc tự sửa lời giải. Phê bình học sinh phải đi cùng sửa hệ thống thưởng-phạt của lớp.
  ],
  [
    Muốn kéo học sinh vào Toán, nhiều khi phải nói bằng ngôn ngữ các em đang sống: game, bóng đá, chuyển động, kinh tế nhỏ, mạng xã hội, hình ảnh quen. Từ chiếc cửa quen ấy mới dẫn sang ký hiệu và khái quát. Một ví dụ trúng thế giới học sinh có thể mở bài mạnh hơn mười dòng định nghĩa.
  ],
  [
    Nếu giáo viên hay nói "sai là bình thường" nhưng vừa sai đã cắt lời hoặc chê vội, lớp sẽ không tin. Dạy Toán cần sự chân thật sư phạm: nói gì thì tổ chức lớp đúng như thế. Khi học sinh thấy mình được sai an toàn, các em mới dám nghĩ thật.
  ],
  [
    Khen ngợi là cần, nhưng nếu lớp sống hoàn toàn bằng lời khen thì học sinh sẽ lệ thuộc vào phản chiếu bên ngoài. Nên giúp các em có tiêu chuẩn tự đánh giá: đọc đề kỹ hơn chưa, lập luận kín hơn chưa, trình bày sáng hơn chưa. Khi nội chuẩn mạnh lên, các em học bền hơn.
  ],
  [
    Cuối một chương hay chuyên đề, rất nên cho học sinh nhìn lại nhiều con đường đã đi: đại số, hình học, tọa độ, hàm số, thử số, cực trị. Hãy hỏi lớp mỗi cách sáng ở đâu và mù ở đâu. Giá trị của dạy Toán phổ thông không chỉ là giải xong, mà là biết chọn đúng công cụ.
  ],
)

#let nhk-supham-note-for(number) = {
  if number >= 1 and number <= _nhk-supham-notes.len() {
    _nhk-supham-notes.at(number - 1)
  } else {
    none
  }
}
