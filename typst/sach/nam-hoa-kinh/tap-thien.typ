// ═══════════════════════════════════════════════════════════
// TẠP THIÊN — Thiên 23 đến 33
// ═══════════════════════════════════════════════════════════
#import "template.typ": *

#nhk-part(
  "Tạp Thiên",
  subtitle: [Thiên 23 – 33 · Giai thoại, phê bình thời đại và những đường vòng của trí tuệ],
)

// ─────────────────────────────────────────────
#nhk-thien(23, "Canh Tang Sở")

#nhk-tomluoc[
  Thiên này xoay quanh việc dạy người và giữ dân. Mọi trị liệu bền lâu đều bắt
  đầu ở chỗ làm cho tâm người bớt rối, chứ không chỉ thay động tác bên ngoài.
  Canh Tang Sở là kiểu thiên rất hợp với người đang quen nghĩ mọi vấn đề có thể
  giải bằng thêm biện pháp, thêm quản lý, thêm lời khuyên bề mặt.

  Trang Tử đi ngược lại. Ông nhắc rằng nếu lòng người còn tán loạn, chính sách
  hay giáo huấn dù đúng cũng khó bén rễ. Dạy người vì thế không chỉ là đưa nội
  dung vào đầu, mà là làm cho cái tâm có chỗ lắng xuống để điều đúng có thể vào.
]

#nhk-binh[
  Khi gốc chưa yên, sửa cành lá chỉ là chữa triệu chứng. Trang Tử thường luôn
  kéo vấn đề trở về chỗ sâu hơn mà xã hội hay bỏ quên: cấu trúc của tâm. Nhiều
  người rất thích giải pháp vì giải pháp cho cảm giác đang làm gì đó. Nhưng nếu
  gốc rối vẫn nguyên, giải pháp chỉ đổi hình thức của cái rối.

  Canh Tang Sở bởi vậy có ích cả cho giáo dục, trị liệu lẫn tự tu thân. Không
  phải việc gì cũng sửa bằng động tác. Có những nút chỉ tháo được khi con người
  thôi tán lực ra khắp nơi và bắt đầu gom tâm lại.
]

#nhk-concept("Chữa từ gốc")[
  Gốc ở đây không phải một bản chất trừu tượng xa xôi, mà là trạng thái nội tâm
  đang điều khiển hành động hằng ngày. Nếu tâm liên tục sợ, nóng, loạn hoặc cố thủ,
  những điều chỉnh bên ngoài sẽ mau chóng bị kéo lệch trở lại.
]

#nhk-goimo[
  Khi một thói quen xấu lặp mãi, thử đừng chỉ hỏi "làm sao bỏ nó" mà hỏi thêm "nó
  đang nuôi cái gì trong mình". Đôi khi thứ cần chạm không phải là hành vi cuối,
  mà là cái đói hay cái lo bên dưới hành vi ấy.
]

// ─────────────────────────────────────────────
#nhk-thien(24, "Từ Vô Quỷ")

#nhk-tomluoc[
  Những cuộc gặp gỡ trong thiên này cho thấy người thật thường không hứng thú
  với việc tô bóng cho tên tuổi mình. Họ nhìn rất rõ cái giá của quyền lực, của
  triều chính và của việc cứ phải sống dưới ánh đèn của người khác. Có những con
  người bước vào giữa danh lợi mà vẫn thấy lạnh tay, vì họ biết càng tiến sâu,
  cái mình phải đổi lấy chưa chắc đáng.

  Từ Vô Quỷ không dạy khinh đời để làm dáng. Nó chỉ lật mặt sau của ảnh hưởng:
  càng được nhìn thấy nhiều, con người càng dễ sống bằng phản ứng của người khác;
  càng ở gần trung tâm quyền lực, càng khó giữ một khoảng yên không bị lôi kéo.
]

#nhk-binh[
  Từ Vô Quỷ đặt ra một câu hỏi còn nguyên hôm nay: muốn có ảnh hưởng hay muốn
  giữ được nội lực? Không phải lúc nào hai điều ấy cũng đi cùng nhau. Rất nhiều
  người leo lên được, nhưng càng lên càng đánh rơi phần vững ở bên trong.

  Thiên này không bảo ai cũng phải lánh đời. Nó chỉ đòi ta tính đúng cái giá của
  mỗi vị trí. Có những thành công tưởng là mở ra, kỳ thực lại khóa con người vào
  một guồng phản chiếu, nơi mình không còn được phép thở như một người bình thường.
]

#nhk-goimo[
  Trước một cơ hội lớn, ngoài câu hỏi "mình có làm được không", còn một câu khác:
  "nếu nhận nó, mình sẽ phải sống thành người như thế nào". Từ Vô Quỷ nhắc rằng
  đôi khi từ chối đúng lúc là cách giữ vốn sống sâu nhất của mình.
]

// ─────────────────────────────────────────────
#nhk-thien(25, "Tắc Dương")

#nhk-tomluoc[
  Ở đây Trang Tử tiếp tục mổ xẻ cách con người tranh nhau đúng sai, danh phận,
  chủ trương. Càng cố áp thế giới vào vài nhãn cứng, ta càng làm nó nứt ra thành
  những cuộc đối đầu không dứt. Tắc Dương giống một lời cảnh báo gửi tới mọi đầu
  óc quá mê hệ thống: khi khái niệm trở thành lưới bắt cả thực tại, phần sống động
  nhất của đời sẽ bị cắt bỏ đầu tiên.

  Trang Tử rất tinh ở điểm này. Ông biết con người cần tên gọi để giao tiếp, cần
  phân biệt để suy nghĩ. Nhưng ông cũng biết ngay khi quên đó chỉ là công cụ, ta sẽ
  biến tên gọi thành nhà tù và bắt cả thế giới phải đứng yên cho mình quản.
]

#nhk-binh[
  Tắc Dương nhắc rằng cái trí quá ham đóng khung rất dễ biến đời sống thành hồ
  sơ. Mà hồ sơ thì tiện quản lý, nhưng không đủ chỗ cho sự sống đang biến hóa.
  Những bi kịch tinh thần lớn thường bắt đầu khi một người lấy mô hình của mình
  làm tiêu chuẩn phán quyết toàn bộ người khác.

  Vì vậy, thiên này không chống tư duy. Nó chống sự độc tài của tư duy khái niệm.
  Nó buộc người đọc nhớ rằng ngoài cái rõ ràng còn có cái phức tạp, ngoài cái phân
  loại được còn có cái chỉ hiểu được khi đứng gần và nhìn đủ lâu.
]

#nhk-concept("Tên gọi là công cụ, không phải bản thể")[
  Một khi quên điều này, ta sẽ đối xử với nhãn như sự thật cuối cùng. Từ đó sinh ra
  những kiểu cứng nhắc quen thuộc: dán nhãn người khác, dán nhãn bản thân, dán nhãn
  một giai đoạn đời rồi sống như thể nhãn ấy không bao giờ thay đổi.
]

// ─────────────────────────────────────────────
#nhk-thien(26, "Ngoại Vật")

#nhk-tomluoc[
  Con người dùng vật để sống, nhưng rất nhanh lại bị vật dùng ngược: danh vị,
  tài sản, công cụ, thậm chí cả quan điểm. Những thứ lẽ ra chỉ là phương tiện có
  thể leo lên ngồi vào ghế chủ nhân của đời ta. Ngoại Vật đi qua nhiều ví dụ để
  chỉ ra một nghịch lý âm thầm: con người chế ra công cụ để tiện hơn, rồi dần sống
  như phụ tá cho chính công cụ và tài sản của mình.

  Không chỉ đồ vật hữu hình. Một lập trường, một danh tiếng, một phương pháp làm
  việc từng giúp ta rất nhiều cũng có thể trở thành "ngoại vật" theo nghĩa ấy: ta
  không còn sử dụng nó linh hoạt nữa, mà bắt đầu lệ thuộc vào nó để cảm thấy mình
  có giá trị hay an toàn.
]

#nhk-binh[
  Bài học của Ngoại Vật không phải ghét đồ vật hay ghét tiện nghi. Nó là giữ cho
  quan hệ giữa mình với vật không đảo chiều. Ta cầm được thì dùng; bị nó cầm thì
  mất tự do. Chỗ sâu của tự do không nằm ở nghèo hay giàu, ít hay nhiều, mà ở chỗ
  ai đang ngồi vào ghế chủ của đời sống mình.

  Thiên này rất gần với những lo âu hiện đại về tiêu dùng, thiết bị và hình ảnh cá
  nhân. Vấn đề không phải có hay không có, mà là sức hút của những thứ ấy đang định
  hình tâm trí mình tới đâu. Khi một ngoại vật bắt đầu quyết định phẩm giá của ta,
  nó không còn là vật nữa.
]

#nhk-dongtay(
  truoc: [
    *Phật giáo:* Chấp thủ không nằm ở đối tượng tự nó, mà ở bàn tay bám vào đối
    tượng. Ngoại Vật nói bằng giọng khác nhưng chạm rất gần vào mấu chốt ấy.
  ],
  sau: [
    *Đời sống số hiện nay:* Thiết bị và nền tảng được tạo ra để phục vụ con người,
    nhưng rất dễ đảo chiều thành nơi điều khiển sự chú ý, nhịp sống và cả cảm giác
    giá trị bản thân của người dùng.
  ],
)

#nhk-goimo[
  Một cách tự kiểm là thử rời một thứ khỏi mình trong chốc lát: điện thoại, một vai
  trò, một hình ảnh, một món đồ, một nhịp làm việc. Nếu vừa rời ra đã thấy hoảng hốt,
  rất có thể ta không còn sở hữu nó đơn thuần nữa.
]

// ─────────────────────────────────────────────
#nhk-thien(27, "Ngụ Ngôn")

#nhk-tomluoc[
  Trang Tử tự ý thức rất rõ rằng nhiều điều không thể dạy thẳng. Vì vậy ông dùng
  ngụ ngôn, lời mượn, chuyện vòng. Nói vòng không phải để né sự thật, mà để đưa
  sự thật vào nơi lý trí phòng thủ ít nhất. Ngụ Ngôn gần như một chìa khóa đọc cả
  cuốn Nam Hoa Kinh: tại sao cứ phải chim lớn, cá lớn, đầu lâu, kẻ trộm, người câu,
  người thợ, giấc mơ và những cuộc đối đáp kỳ quặc?

  Bởi có những điều nếu trình bày theo luận đề trực tiếp, người nghe sẽ lập tức kéo
  toàn bộ kho thành kiến ra chống trả. Câu chuyện đi đường vòng hơn, nhưng có thể mở
  một cánh cửa khác của nhận thức. Nó không đánh gục ta bằng lý lẽ duy nhất; nó làm
  ta tự thấy một điều vốn chưa từng chịu nhìn.
]

#nhk-binh[
  Thiên này gần như một lời thú nhận về chính phong cách của Nam Hoa Kinh. Có
  điều, nếu nói trực diện, người nghe sẽ lập tức dựng tường phản bác. Nhưng nếu
  kể thành chuyện, cánh cửa bên hông của tâm trí có thể mở ra. Chính vì thế mà triết
  học của Trang Tử đọc vừa như văn chương vừa như tư tưởng.

  Ngụ Ngôn cũng nhắc ta khiêm tốn với chính ngôn ngữ của mình. Không phải cứ nói
  thẳng là sâu hơn, cũng không phải cứ lập luận chặt là chạm được nơi con người thật
  sự đổi. Có khi một ẩn dụ đúng còn làm việc lâu hơn cả một bài giảng dài.
]

#nhk-concept("Đường vòng của sự thật")[
  Đường vòng không phải đường giả. Nó là hình thức thích hợp cho một loại chân lý mà
  nếu cầm quá chặt, nói quá thẳng, nó sẽ chết khô. Ngụ ngôn giữ được độ mở để người
  đọc bước vào bằng kinh nghiệm riêng của mình.
]

#nhk-trich(
  source: [Tinh thần toàn bộ Nam Hoa Kinh],
)[
  "Có những điều không thể đưa thẳng vào tai bằng mệnh lệnh, nên phải đưa vòng qua
  một câu chuyện để nó đến được tim."
]

// ─────────────────────────────────────────────
#nhk-thien(28, "Nhượng Vương")

#nhk-tomluoc[
  Nhiều bậc hiền trong thiên này từ chối ngôi cao. Họ không coi việc đứng đầu là
  phần thưởng hiển nhiên của người có đức. Có khi tránh ngai vàng mới là cách giữ
  được điều quý nhất nơi mình. Nhượng Vương vì thế không chỉ kể những cuộc thoái vị;
  nó thử đảo ngược toàn bộ trực giác thông thường về thành công và trách nhiệm.

  Ta quen nghĩ người giỏi thì nên lên trên, người có đức thì nên cầm quyền. Nhưng
  Trang Tử buộc ta nhìn kỹ hơn: vị trí càng cao, nguy cơ bị cuốn vào biểu diễn, vào
  bận bịu, vào tính toán và vào trách nhiệm làm khô phần sống sâu nhất của mình càng
  lớn. Không phải ai thích hợp làm người thầy cũng thích hợp làm người trị.
]

#nhk-binh[
  Nhượng Vương làm lộ một tiêu chuẩn khác về thành công. Nếu một vị trí buộc ta
  đánh đổi mất khí chất và tự do tinh thần, thì việc từ chối nó có thể là hành vi
  sáng suốt hơn nhiều so với việc bước lên. Trong mắt người đời, từ chối thường bị
  xem là bỏ lỡ; trong mắt Trang Tử, từ chối đúng có thể là giữ trọn.

  Thiên này cũng cứu người đọc khỏi một thứ đạo đức cưỡng bức: cứ có năng lực là phải
  gánh lấy mọi vai lớn. Không. Có những tài năng nở đẹp nhất ở bên rìa quyền lực. Có
  những tâm hồn chỉ còn sáng nếu không bị buộc vào ngai ghế.
]

#nhk-goimo[
  Nhiều quyết định khó không phải giữa tốt và xấu, mà giữa hai thứ đều đẹp trên giấy.
  Nhượng Vương nhắc rằng khi chọn đường đi, cần tính tới điều gì sẽ còn lại của mình
  sau vài năm sống trong vai đó, chứ không chỉ nhìn vẻ sáng của vai ngay lúc nhận.
]

// ─────────────────────────────────────────────
#nhk-thien(29, "Đạo Chích")

#nhk-tomluoc[
  Đây là một thiên rất gai góc. Nhân vật Đạo Chích dùng chính ngôn ngữ lý luận để
  công kích thứ đạo đức giả đang thống trị xã hội. Đọc khó chịu, nhưng khó chịu là
  chủ ý của Trang Tử: ông ép người đọc nhìn thẳng vào khoảng cách giữa lời hay và
  đời sống thật. Đạo Chích không phải nhân vật dễ yêu. Chính vì vậy mà tiếng nói của
  hắn càng gây sốc: từ bên ngoài đạo đức chính thống, hắn bóc ra những ngụy trang mà
  người trong hệ thống lâu ngày đã xem như bình thường.

  Thiên này đưa người đọc vào vùng cực khó của triết học: làm sao phê bình đạo đức giả
  mà không rơi sang tôn vinh vô đạo? Trang Tử không đơn giản hóa vấn đề. Ông để sự khó
  chịu ở nguyên đó, vì đôi khi chỉ có va chạm mạnh mới làm lớp sơn nứt ra.
]

#nhk-binh[
  Thiên này không cổ vũ cướp bóc. Nó lột cái mặt nạ của xã hội khi đạo lý bị biến
  thành công cụ trang trí quyền lực. Khi chính danh nghĩa thiện lương bị dùng sai,
  lời phê bình buộc phải sắc như dao. Nói dịu quá trong bối cảnh ấy có thể lại thành
  một dạng đồng lõa.

  Đạo Chích làm ta khó xử vì nó không cho phép yên tâm ở một phe đạo đức đơn giản.
  Nó nhắc rằng hệ thống có thể sản sinh ra những kẻ phản kháng méo mó chính vì bản thân
  nó đã méo trước. Muốn sửa điều này, không thể chỉ phạt phần ngọn; phải nhìn vào thứ
  đời sống đã tạo ra chúng.
]

#nhk-concept("Phê bình không đồng nghĩa với tán thành")[
  Trang Tử để kẻ dữ nói ra sự thật khó nghe không có nghĩa ông đứng về phía cái dữ.
  Ông chỉ cho thấy chân lý đôi khi xuất hiện từ một miệng lưỡi rất khó chịu. Người đọc
  phải đủ tỉnh để nhận ra phần đúng mà không thần tượng luôn người nói.
]

#nhk-dongtay(
  truoc: [
    *Mặc gia và Pháp gia:* Khi xã hội rối, nhiều học phái chọn siết chặt chuẩn mực.
    Trang Tử đi khác: ông nghi cả chính những chuẩn mực đang tự xem mình vô tội.
  ],
  sau: [
    *Phê bình xã hội hiện đại:* Không ít tiếng nói gay gắt nhất xuất hiện từ rìa xã hội,
    nơi người ta trực tiếp cảm nhận sự vênh giữa mỹ từ công khai và cấu trúc thật.
  ],
)

// ─────────────────────────────────────────────
#nhk-thien(30, "Thuyết Kiếm")

#nhk-tomluoc[
  Trang Tử đi vào thế giới của kiếm để nói chuyện không phải về chém giết, mà về
  các cấp độ của khí phách và trị đạo. Ông lấy ngôn ngữ mà người nghe mê nhất để
  bẻ hướng họ sang một chân trời khác. Người mê kiếm sẽ không mở lòng với một bài
  giảng thuần đạo đức, nhưng có thể nghe nếu Đạo bước vào qua chính hình ảnh họ kính.

  Vì thế Thuyết Kiếm vừa là câu chuyện về kiếm vừa không phải về kiếm. Nó là bài học
  về nghệ thuật nói đúng ngôn ngữ của đối tượng để đưa họ sang tầng nhận thức cao hơn.
  Trí tuệ ở đây không nằm ở việc nói điều mình thích, mà ở chỗ mở được cánh cửa người
  kia còn chịu bước qua.
]

#nhk-binh[
  Đây là nghệ thuật giáo hóa rất đặc biệt: không nói từ nơi mình thích nói, mà nói
  từ cánh cửa người kia còn chịu mở. Hiểu người nghe là một phần của trí tuệ. Không
  hiểu điều ấy, mọi chân lý đều có thể hóa vô dụng vì đến sai cách.

  Thuyết Kiếm cũng sửa một ngộ nhận về người hiền: người hiền không phải lúc nào cũng
  nói bằng một giọng duy nhất. Có khi họ phải mượn hình ảnh của quyền lực, vũ lực hay
  kỹ thuật để chuyển tâm người nghe đi. Phương tiện linh hoạt không làm mục đích thấp.
]

#nhk-goimo[
  Khi muốn giúp ai đó thay đổi, đừng vội hỏi điều gì đúng nhất trong đầu mình, mà hỏi
  thêm người kia đang sống bằng hệ hình nào, ngôn ngữ nào, nỗi sợ nào. Nói trúng cửa
  không phải thỏa hiệp với sai; đó là điều kiện để sự đúng có nơi đi vào.
]

// ─────────────────────────────────────────────
#nhk-thien(31, "Ngư Phụ")

#nhk-tomluoc[
  Người đánh cá chất vấn Khổng Tử và lớp người quá nặng vai diễn đạo đức. Ông kéo
  câu chuyện về lại một điểm giản dị: nếu nội tâm chưa ngay thật mà lời nói đã quá
  đúng mực, cái đúng ấy dễ trở thành lớp son. Ngư Phụ dùng giọng người ngoài hệ thống
  để hỏi vào đúng chỗ người trong hệ thống ít muốn nghe nhất: đạo đức có đang sống thật
  trong người, hay mới chỉ sống trong lời?

  Hình ảnh người đánh cá rất hay vì đó là người ở gần nước, gần nhịp sống bình dị, ít
  bị trói bởi lễ văn. Từ vị trí ấy, ông soi lại những điều tưởng như cao quý mà hóa ra có
  thể đã thành lớp vỏ. Câu hỏi của thiên này không chống lễ; nó chống sự giả do lễ che.
]

#nhk-binh[
  Ngư Phụ không nhằm hạ thấp Nho gia cho vui. Nó chỉ nhắc rằng nghi lễ hay giáo huấn
  không cứu được một cái tâm đã xa sự chân thành. Gốc vẫn phải quay về gốc. Điều đáng
  sợ không phải là chưa đủ lời đúng, mà là có quá nhiều lời đúng che mất khoảng trống bên
  trong.

  Thiên này rất có giá trị cho mọi nghề cần nói điều hay: dạy học, lãnh đạo, diễn thuyết,
  làm nội dung, hướng dẫn tâm linh. Càng nói thứ đẹp, càng phải tự hỏi phần sống của mình
  đã đi tới đâu. Nếu không, lời càng đẹp càng dễ biến thành màn che.
]

#nhk-trich(
  source: [Tinh thần của Ngư Phụ],
)[
  "Lễ nghĩa nếu không có chỗ thật để đứng thì chỉ như lớp sơn mới quét lên gỗ mục."
]

#nhk-goimo[
  Một cách tự soi rất hữu ích là xem khoảng cách giữa điều mình hay nói với điều mình
  đang sống xa tới đâu. Thấy khoảng cách ấy không phải để tự khinh mình, mà để bớt dùng
  lời đúng như một chỗ trú ẩn cho phần chưa thật.
]

// ─────────────────────────────────────────────
#nhk-thien(32, "Liệt Ngự Khấu")

#nhk-tomluoc[
  Những câu chuyện quanh Liệt Ngự Khấu chạm vào một thứ rất nhẹ mà rất dính: danh.
  Danh không phải lúc nào cũng ồn ào. Nhiều khi nó đến dưới dạng mong được hiểu,
  được thừa nhận, được đặt đúng chỗ trong mắt người khác. Chính vì danh có thể rất
  tinh nên nó khó gỡ hơn nhiều kiểu ham muốn thô sơ.

  Liệt Ngự Khấu làm lộ ra sự mệt của đời sống phản chiếu: ta không còn chỉ sống với
  việc mình làm, mà sống với ảnh của mình trong tâm người khác. Mỗi lời khen chê, mỗi
  đánh giá, mỗi sự công nhận đều có thể thành sợi dây nhỏ kéo tâm trí đi rất xa.
]

#nhk-binh[
  Trang Tử nhìn ra sự mệt của người sống bằng phản chiếu xã hội. Khi mình quá cần
  một hình ảnh tốt về mình, mình trao chìa khóa bình an cho người ngoài cầm hộ. Đây
  là một trong những hình thức mất tự do phổ biến nhất mà lại dễ được ngợi khen nhất.

  Liệt Ngự Khấu không bảo ta thành kẻ bất cần dư luận hoàn toàn. Nó chỉ muốn trả lại
  tương quan đúng: danh có thể đến, có thể đi, nhưng không nên trở thành nền tảng chính
  cho việc ta biết mình là ai. Sống như vậy quá mong manh và quá tốn sức.
]

#nhk-concept("Danh tinh vi")[
  Danh tinh vi không phải ham nổi tiếng theo cách phô trương. Nó là nhu cầu âm thầm được
  xác nhận là đúng, sâu, tử tế, quan trọng, khác biệt hoặc đáng ngưỡng mộ. Vì nghe đẹp,
  nó thường trú rất lâu trong người mà không bị nhận ra.
]

#nhk-goimo[
  Nếu một lời chê nhỏ có thể làm cả ngày mình chao đảo, hoặc một lời khen đủ làm mình lên
  cao quá mức, có lẽ danh vẫn đang điều khiển nhịp trong. Nhận ra điều đó là bước đầu để
  lấy lại chìa khóa bình an từ tay người khác.
]

// ─────────────────────────────────────────────
#nhk-thien(33, "Thiên Hạ")

#nhk-tomluoc[
  Thiên cuối như một bức tranh rộng về các học phái thời Tiên Tần. Trang Tử nhìn
  quanh thiên hạ, nhận ra ai cũng nắm được một mảnh nào đó, nhưng ít ai giữ được sự
  rộng để không biến mảnh của mình thành toàn bộ chân lý. Thiên Hạ giống một cuộc
  tổng duyệt tư tưởng, nơi các đường lối trị đời, sửa người, lập ngôn và nhận thức
  lần lượt hiện ra với cả điểm mạnh lẫn giới hạn riêng.

  Điều rất đẹp là thiên này không chỉ chê. Nó nhận mỗi nhà có một phần hợp lý, một
  mũi nhọn riêng, một cách thấy đáng quý. Nhưng chính vì ai cũng nắm được một phần,
  nguy cơ lớn nhất là tưởng phần mình nắm chính là toàn bộ bầu trời. Trang Tử từ đầu
  tới cuối đều chống lại kiểu khép kín ấy.
]

#nhk-binh[
  Kết lại ở đây rất đẹp: Nam Hoa Kinh không tự phong mình là chủ nhân duy nhất của
  Đạo. Thiên Hạ vừa phê bình, vừa bao dung. Nó nhắc ta rằng tư tưởng lớn không sinh
  ra để lập một chiếc chuồng mới, mà để mở thêm bầu trời cho việc nhìn. Từ góc này,
  Thiên Hạ là một kết thúc rất xứng cho toàn bộ cuốn sách.

  Sau bao nhiêu thiên đập vào bản ngã, vào danh, vào công dụng, vào tri thức cứng,
  cuốn sách khép lại bằng một bài học về độ rộng tinh thần. Càng học sâu một đường,
  càng phải biết đường ấy đang sáng ở đâu và mù ở đâu. Không biết giới hạn của mình,
  cái sâu rất dễ biến thành cái hẹp.
]

#nhk-dongtay(
  truoc: [
    *Bách gia chư tử:* Mỗi nhà nắm một mặt của đời sống: trị quốc, lễ nghi, danh
    lý, pháp luật, dưỡng sinh. Trang Tử quý sự rộng hơn việc thắng thua giữa các phái.
  ],
  sau: [
    *Đời sống học thuật hôm nay:* Chuyên môn hóa giúp đào sâu, nhưng cũng dễ khiến
    người ta tưởng chiếc giếng của mình là toàn bộ bầu trời. Thiên Hạ nhắc ta học
    thật sâu mà vẫn giữ khả năng bước ra ngoài giếng.
  ],
)

#nhk-goimo[
  Có thể đọc xong Nam Hoa Kinh mà không nhớ hết 33 thiên. Điều đáng giữ hơn là một
  năng lực mới: biết nghi ngờ những chiếc lồng vô hình đang nhốt cái nhìn của mình,
  và biết quay về sự thong dong mỗi khi đời bắt đầu kéo tâm trí đi quá xa.

  Đó cũng là lý do nên đọc lại. Mỗi giai đoạn sống, "thiên hạ" quanh ta đổi khác,
  và chiếc lồng vô hình cũng đổi khác. Có lần nó là danh, có lần là đúng sai, có lần
  là công dụng, có lần là cả một lý tưởng đẹp. Trang Tử không đưa công thức ra khỏi
  mọi lồng; ông cho ta một đôi mắt tốt hơn để nhận ra chúng.
]
