#import "_config.typ": *

#chapter(
  [Tiến Hóa Của Trí Tuệ — Hành Trình 500 Triệu Năm],
  theme-color: c-evo,
)

#lythuyet[
  Não bộ của con người không tự nhiên mà có. Đây là sản phẩm của quá trình
  tiến hóa kéo dài hàng trăm triệu năm — một hành trình từ những hệ thần
  kinh đơn giản nhất của sứa biển, qua bộ não bò sát, não thú, và cuối
  cùng đến vỏ não trước trán phức tạp chưa từng có của *Homo sapiens*.
]

#lesson([Lịch sử não bộ — Dòng thời gian tiến hóa], theme-color: c-evo)

#timeline-event([~600 triệu năm trước], [
  *Hệ thần kinh đầu tiên* xuất hiện ở Cnidaria (sứa, san hô). Chỉ là
  mạng lưới thần kinh phân tán, không có não trung tâm. Chức năng: phản
  xạ đơn giản với kích thích vật lý (ánh sáng, nhiệt độ).
], accent: c-evo)

#timeline-event([~525 triệu năm trước], [
  *Não nguyên thủy* hình thành ở cá không hàm (lamprey). Xuất hiện ba
  phần cơ bản: não trước (prosencephalon), não giữa (mesencephalon), và
  não sau (rhombencephalon). Đây là nguyên mẫu của toàn bộ não động vật
  có xương sống.
], accent: c-evo)

#timeline-event([~350 triệu năm trước], [
  *Bò sát* xuất hiện. Não bò sát (reptilian brain) hay còn gọi là *R-complex*
  kiểm soát các hành vi bản năng: hô hấp, tuần hoàn, tiêu hóa, lãnh thổ,
  giao phối. Đây là phần não chúng ta vẫn còn nguyên vẹn.
], accent: c-neuro)

#timeline-event([~200 triệu năm trước], [
  *Thú có vú* xuất hiện. Hệ viền (limbic system) phát triển xung quanh
  R-complex. Đây là "não cảm xúc" — phát sinh tình cảm, ký ức, gắn bó
  giữa mẹ và con, học hỏi theo kinh nghiệm.
], accent: c-brain)

#timeline-event([~65 triệu năm trước], [
  Đại tuyệt chủng khủng long. *Linh trưởng nguyên thủy* xuất hiện. Vỏ não
  (neocortex) bắt đầu mở rộng. Thị giác hai mắt, ngón tay linh hoạt, cuộc
  sống xã hội phức tạp thúc đẩy tiến hóa não.
], accent: c-book)

#timeline-event([~7 triệu năm trước], [
  *Australopithecus* — tổ tiên xa nhất trong nhánh người. Não đã đạt ~450 ml,
  lớn hơn tinh tinh. Bắt đầu đi bằng hai chân, giải phóng hai tay.
], accent: c-book)

#timeline-event([~2.5 triệu năm trước], [
  *Homo habilis* — "người khéo tay". Đột phá lớn: biết chế tác công cụ đá.
  Não đạt ~700 ml. Bắt đầu mở rộng chế độ ăn uống (ăn thịt), thay đổi
  metabolic cho phép não phát triển hơn.
], accent: c-book)

#timeline-event([~300.000 năm trước], [
  *Homo sapiens* xuất hiện tại Châu Phi. Não đạt ~1.350 ml. Vỏ não trước
  trán (prefrontal cortex) phát triển mạnh — trung tâm của tư duy trừu
  tượng, lập kế hoạch, kiểm soát xung động và ý thức xã hội.
], accent: c-philo)

#timeline-event([~70.000 năm trước], [
  *Cuộc cách mạng nhận thức* — Homo sapiens đột ngột phát triển ngôn ngữ
  phức tạp, nghệ thuật hang động, thương mại, tôn giáo. Bước nhảy này
  không đến từ thay đổi gen não mà từ *sự xuất hiện của ngôn ngữ* tượng
  trưng (symbolic language).
], accent: c-philo)

#section([Giả thuyết "Não Xã hội" — Social Brain Hypothesis], theme-color: c-evo)

#nghiencuu(title: [🔬 Robin Dunbar và Số Dunbar], accent: c-neuro)[
  Nhà nhân học Robin Dunbar tại Đại học Oxford phát hiện một tương quan
  đáng kinh ngạc: *kích thước vỏ não tỉ lệ thuận với kích thước nhóm xã hội*
  của các loài linh trưởng.
  
  Áp dụng công thức này cho con người: não người có thể duy trì ổn định
  khoảng *150 mối quan hệ xã hội* — nay gọi là "Số Dunbar" (Dunbar's Number).
  
  Điều này gợi ý rằng não người không tiến hóa chủ yếu để giải quyết các
  vấn đề vật lý (tìm thức ăn, tránh thú dữ), mà để *quản lý các mạng lưới
  xã hội phức tạp*: theo dõi ai trung thành với ai, ai đang lừa dối, ai
  có thể là đồng minh.
]

#khainiemboc(title: [📖 Thuyết Tâm trí (Theory of Mind — ToM)], accent: c-brain)[
  Thuyết tâm trí là khả năng *nhận ra rằng người khác có những trạng thái
  tinh thần, niềm tin và mong muốn khác với mình*. Đây là một trong những
  năng lực nhận thức đặc biệt nhất của con người:
  
  - Trẻ em phát triển ToM ở khoảng 4 tuổi (kiểm tra "bài kiểm tra Sally-Anne")
  - Người tự kỷ thường gặp khó khăn với ToM
  - Tinh tinh có ToM sơ khai; chó có thể hiểu ý định của người
  
  ToM cho phép con người: *nói dối, lừa dối, đồng cảm, giảng dạy, hợp tác
  ở quy mô lớn* — tất cả đều là nền tảng của văn minh.
]

#section([Ngôn ngữ — Đòn bẩy của tiến hóa nhận thức], theme-color: c-evo)

#trichdan(
  author: [Noam Chomsky],
  source: [Language and Mind, 1968],
)[
  "Ngôn ngữ là tấm gương của tâm trí theo nghĩa sâu sắc nhất — nó là
  sản phẩm của trí thông minh con người."
]

#lydo(title: [💡 Tại sao ngôn ngữ là bước ngoặt tiến hóa?], accent: c-brain)[
  Ngôn ngữ không chỉ là công cụ giao tiếp. Nó là *công nghệ lưu trữ và
  truyền thông tin ngoài cơ thể* — "cognitive offloading" đầu tiên của
  loài người:
  
  + *Truyền kiến thức qua thế hệ*: Không cần phải tự học lại từ đầu. Kinh nghiệm của người chết vẫn tồn tại qua câu chuyện, nghi lễ, sau đó là chữ viết.
  
  + *Hợp tác số đông*: Chỉ con người mới có thể huy động hàng nghìn người xa lạ để cùng thực hiện một mục tiêu chung (xây kim tự tháp, tạo ra một quốc gia, phát động chiến tranh) thông qua các "huyền thoại liên chủ quan" (inter-subjective myths): tiền, pháp luật, tôn giáo, quốc gia.
  
  + *Tư duy trừu tượng*: Ngôn ngữ cho phép con người suy nghĩ về những thứ không hiện hữu trước mắt — quá khứ, tương lai, giả thuyết, triết học, toán học.
]

#nghiencuu(title: [🔬 Vùng Broca và Wernicke — Não ngôn ngữ], accent: c-neuro)[
  Thế kỷ 19, hai nhà khoa học Paul Broca (1861) và Carl Wernicke (1874)
  lần lượt phát hiện các vùng não chuyên xử lý ngôn ngữ:
  
  - *Vùng Broca* (thùy trán trái): Kiểm soát sản xuất ngôn ngữ. Tổn thương
    gây ra *mất ngôn ngữ Broca*: hiểu nhưng không nói được.
  
  - *Vùng Wernicke* (thùy thái dương trái): Xử lý ngôn ngữ nghe được. Tổn
    thương gây ra *mất ngôn ngữ Wernicke*: nói được nhưng vô nghĩa.
  
  Hai vùng này nối với nhau bởi bó cung (arcuate fasciculus) — một "xa lộ"
  thông tin ngôn ngữ. Cấu trúc này gần như độc nhất ở con người.
]

#lesson([Tiến hóa văn hóa — Khi gen không còn đủ], theme-color: c-evo)

#khainiemboc(title: [📖 Tiến hóa kép (Dual Inheritance Theory)], accent: c-evo)[
  Con người không chỉ tiến hóa thông qua *tiến hóa di truyền* (gen thay
  đổi qua nhiều thế hệ), mà còn qua *tiến hóa văn hóa* (ý tưởng, kỹ thuật,
  hành vi lây lan và thay đổi nhanh hơn nhiều so với gen).
  
  Trong 10.000 năm qua, gen người hầu như không thay đổi — nhưng chúng ta
  đã đi từ làng bộ lạc đến thành phố triệu dân, từ gậy gộc đến máy tính
  lượng tử. *Văn hóa là bộ não thứ hai của loài người.*
]

#trithuc(title: [★ Meme — Đơn vị tiến hóa văn hóa], accent: c-evo)[
  Richard Dawkins (1976) đề xuất khái niệm "meme" — đơn vị thông tin văn
  hóa có thể nhân bản, biến đổi và "cạnh tranh sống sót" giống như gen:
  một giai điệu, một ý tưởng, một kiểu ăn mặc, một học thuyết khoa học.
  
  Những meme nào phù hợp với tâm lý người (dễ nhớ, dễ lây, gắn với cảm
  xúc) sẽ lan rộng và tồn tại; những meme không phù hợp sẽ biến mất.
  
  Đây là cách văn minh vận hành: *tiến hóa Darwinian của ý tưởng*, không
  phải của thể xác.
]

#lydo(title: [💡 Điểm chốt chương 2], accent: c-brain)[
  Trí tuệ con người là kết quả của *ba tầng tiến hóa chồng lên nhau*:
  
  + *Tiến hóa sinh học* — 500 triệu năm phát triển hệ thần kinh
  + *Tiến hóa văn hóa* — 70.000 năm tích lũy kiến thức qua ngôn ngữ
  + *Tiến hóa cá nhân* — Học hỏi suốt đời qua trải nghiệm
  
  Không một tầng nào tự mình đủ để giải thích toàn bộ. Chương tiếp theo
  sẽ đi sâu vào *cơ chế vật lý bên trong hộp sọ*.
]
