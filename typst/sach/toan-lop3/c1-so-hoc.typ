// c1-so-hoc.typ — Chapter 1: Numbers to 10,000

#import "_theme.typ": *

#page[
  #chapter-header(1, "Số đến 10,000 / Numbers to 10,000", C-CH.at(0))

  #learning-objectives[
    - Đọc và viết số đến 10,000 / Read and write numbers up to 10,000
    - So sánh các số / Compare numbers
    - Làm tròn số / Round numbers
    - Sử dụng tia số / Use number lines
  ]

  #section-divider()

  #key-reminder[
    #v(0.3em)
    - Số có 4 chữ số: hàng nghìn, hàng trăm, hàng chục, hàng đơn vị
    - Ví dụ: 3 456 = 3 nghìn + 4 trăm + 5 chục + 6 đơn vị
    - Đọc số: Ba nghìn bốn trăm năm mươi sáu
    - English: Three thousand four hundred fifty-six
  ]

  #section-divider()

  #example[
    #v(0.3em)
    Viết số: Bảy nghìn tám trăm chín mươi hai
    #v(0.3em)
    Đáp án: 7 892
    #v(0.3em)
    Write: Seven thousand eight hundred ninety-two
    #v(0.3em)
    Answer: 7,892
  ]

  #section-divider()

  #exercise-section("Bài tập cơ bản / Basic Exercises", [
    #math-problem(1, "Viết các số sau: 4 567, 8 901, 2 345")
    #math-problem(2, "Đọc các số: 6 789, 3 210, 9 876")
    #math-problem(3, "Sắp xếp theo thứ tự tăng dần: 5 432, 4 321, 6 543")
    #math-problem(4, "Làm tròn 3 678 đến hàng trăm")
    #math-problem(5, "Làm tròn 7 234 đến hàng nghìn")
  ])

  #section-divider()

  #exercise-section("Bài tập luyện tập / Practice Exercises", [
    #math-problem(6, "Tìm số lớn nhất: 4 567, 4 576, 4 657")
    #math-problem(7, "Tìm số bé nhất: 8 901, 8 109, 8 910")
    #math-problem(8, "Viết số gồm: 5 nghìn, 3 trăm, 0 chục, 2 đơn vị")
    #math-problem(9, "Điền dấu >, <, =: 4 567 ___ 4 576")
    #math-problem(10, "Làm tròn 9 999 đến hàng nghìn")
  ])

  #section-divider()

  #exercise-section("Bài tập tư duy / Thinking Challenges", [
    #math-problem(11, "Tìm số có 4 chữ số biết tổng các chữ số bằng 10 và chữ số hàng nghìn gấp đôi chữ số hàng đơn vị")
    #math-problem(12, "Có bao nhiêu số có 4 chữ số mà chữ số hàng trăm bằng 5?")
    #math-problem(13, "Số nào lớn hơn: 4 567 hay 4 576? Giải thích tại sao.")
  ])

  #progress-tracker(1, 3)
]
