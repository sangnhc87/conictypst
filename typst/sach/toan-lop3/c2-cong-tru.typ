// c2-cong-tru.typ — Chapter 2: Addition and Subtraction

#import "_theme.typ": *

#page[
  #chapter-header(2, "Cộng – Trừ / Addition – Subtraction", C-CH.at(1))

  #learning-objectives[
    - Cộng có nhớ nhiều lần / Multi-digit addition with carrying
    - Trừ có nhớ nhiều lần / Multi-digit subtraction with borrowing
    - Đặt tính cột dọc / Vertical column method
    - Giải bài toán có lời văn / Solve word problems
  ]

  #section-divider()

  #key-reminder[
    #v(0.3em)
    - Cộng từ phải sang trái, nhớ khi tổng ≥ 10
    - Trừ từ phải sang trái, mượn khi số bị trừ nhỏ hơn số trừ
    - Đặt thẳng hàng: nghìn, trăm, chục, đơn vị
    - English: Add from right to left, carry when sum ≥ 10
    - Subtract from right to left, borrow when minuend \< subtrahend
  ]

  #section-divider()

  #example[
    #v(0.3em)
    Tính: 3 456 + 2 789
    #v(0.3em)
    Đặt tính:
    #v(0.3em)
      3 456
    + 2 789
    ——————
      6 245
    #v(0.3em)
    Giải thích: 6+9=15 viết 5 nhớ 1; 5+8+1=14 viết 4 nhớ 1; 4+7+1=12 viết 2 nhớ 1; 3+2+1=6
  ]

  #section-divider()

  #exercise-section("Bài tập cơ bản / Basic Exercises", [
    #math-problem(1, "Tính: 2 345 + 1 234")
    #math-problem(2, "Tính: 5 678 - 3 456")
    #math-problem(3, "Tính: 4 567 + 3 789")
    #math-problem(4, "Tính: 8 901 - 4 567")
    #math-problem(5, "Đặt tính rồi tính: 6 789 + 2 345")
  ])

  #section-divider()

  #exercise-section("Bài tập luyện tập / Practice Exercises", [
    #math-problem(6, "Một cửa hàng có 3 456 quyển sách. Nhập thêm 2 789 quyển. Hỏi có tất cả bao nhiêu quyển?")
    #math-problem(7, "Một bể cá có 5 678 con cá. Bán đi 3 456 con. Hỏi còn lại bao nhiêu con?")
    #math-problem(8, "Tính: 9 876 - 5 432")
    #math-problem(9, "Tính: 4 321 + 5 678")
    #math-problem(10, "Điền số thích hợp: 3 456 + ___ = 7 890")
  ])

  #section-divider()

  #exercise-section("Bài tập tư duy / Thinking Challenges", [
    #math-problem(11, "Tìm hai số có tổng bằng 10 000 và hiệu bằng 2 000")
    #math-problem(12, "Có bao nhiêu cách viết 5 000 thành tổng của hai số có 4 chữ số?")
    #math-problem(13, "Một số khi cộng với 3 456 được 7 890. Tìm số đó.")
  ])

  #progress-tracker(2, 3)
]
