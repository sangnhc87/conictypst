// c3-nhan-chia.typ — Chapter 3: Multiplication and Division

#import "_theme.typ": *

#page[
  #chapter-header(3, "Nhân – Chia / Multiplication – Division", C-CH.at(2))

  #learning-objectives[
    - Bảng nhân 6, 7, 8, 9 / Multiplication tables 6, 7, 8, 9
    - Chia có dư / Division with remainder
    - Nhân với 10, 100 / Multiply by 10, 100
    - Chia cho 10, 100 / Divide by 10, 100
  ]

  #section-divider()

  #key-reminder[
    #v(0.3em)
    - Bảng nhân 6: 6 × 1 = 6, 6 × 2 = 12, ..., 6 × 9 = 54
    - Bảng nhân 7: 7 × 1 = 7, 7 × 2 = 14, ..., 7 × 9 = 63
    - Bảng nhân 8: 8 × 1 = 8, 8 × 2 = 16, ..., 8 × 9 = 72
    - Bảng nhân 9: 9 × 1 = 9, 9 × 2 = 18, ..., 9 × 9 = 81
    - Chia có dư: 17 ÷ 5 = 3 dư 2 (vì 3 × 5 = 15, 17 - 15 = 2)
    - Nhân với 10: thêm một chữ số 0 (6 × 10 = 60)
    - Chia cho 10: bỏ một chữ số 0 (60 ÷ 10 = 6)
  ]

  #section-divider()

  #example[
    #v(0.3em)
    Tính: 7 × 8 = ?
    #v(0.3em)
    Đáp án: 56 (vì 7 × 8 = 56)
    #v(0.3em)
    Tính: 45 ÷ 6 = ?
    #v(0.3em)
    Đáp án: 7 dư 3 (vì 6 × 7 = 42, 45 - 42 = 3)
  ]

  #section-divider()

  #exercise-section("Bài tập cơ bản / Basic Exercises", [
    #math-problem(1, "Tính: 6 × 7")
    #math-problem(2, "Tính: 8 × 9")
    #math-problem(3, "Tính: 7 × 6")
    #math-problem(4, "Tính: 9 × 8")
    #math-problem(5, "Tính: 54 ÷ 6")
  ])

  #section-divider()

  #exercise-section("Bài tập luyện tập / Practice Exercises", [
    #math-problem(6, "Tính: 7 × 9")
    #math-problem(7, "Tính: 63 ÷ 7")
    #math-problem(8, "Tính: 8 × 6")
    #math-problem(9, "Tính: 72 ÷ 8")
    #math-problem(10, "Tính: 45 ÷ 7 (có dư)")
    #math-problem(11, "Tính: 6 × 10")
    #math-problem(12, "Tính: 80 ÷ 10")
  ])

  #section-divider()

  #exercise-section("Bài tập tư duy / Thinking Challenges", [
    #math-problem(13, "Tìm số tự nhiên x biết: 6 × x = 42")
    #math-problem(14, "Có 35 cái kẹo chia đều cho 8 bạn. Hỏi mỗi bạn được mấy cái và còn dư mấy cái?")
    #math-problem(15, "Tìm số có 2 chữ số biết tích các chữ số bằng 12 và số đó chia hết cho 6")
  ])

  #progress-tracker(3, 3)
]
