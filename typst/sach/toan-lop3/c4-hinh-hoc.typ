// c4-hinh-hoc.typ — Chapter 4: Geometry

#import "_theme.typ": *

#page[
  #chapter-header(4, "Hình Học / Geometry", C-CH.at(3))

  #learning-objectives[
    - Chu vi hình chữ nhật / Perimeter of rectangle
    - Chu vi hình vuông / Perimeter of square
    - Diện tích hình chữ nhật / Area of rectangle
    - Diện tích hình vuông / Area of square
  ]

  #section-divider()

  #key-reminder[
    #v(0.3em)
    - Chu vi hình chữ nhật = (dài + rộng) × 2
    - Chu vi hình vuông = cạnh × 4
    - Diện tích hình chữ nhật = dài × rộng
    - Diện tích hình vuông = cạnh × cạnh
    - Đơn vị: cm, m; diện tích: cm², m²
    - English:
      - Rectangle perimeter = (length + width) × 2
      - Square perimeter = side × 4
      - Rectangle area = length × width
      - Square area = side × side
  ]

  #section-divider()

  #example[
    #v(0.3em)
    Hình chữ nhật có chiều dài 8 cm, chiều rộng 5 cm.
    #v(0.3em)
    Chu vi = (8 + 5) × 2 = 26 cm
    #v(0.3em)
    Diện tích = 8 × 5 = 40 cm²
    #v(0.3em)
    Hình vuông có cạnh 6 cm.
    #v(0.3em)
    Chu vi = 6 × 4 = 24 cm
    #v(0.3em)
    Diện tích = 6 × 6 = 36 cm²
  ]

  #section-divider()

  #exercise-section("Bài tập cơ bản / Basic Exercises", [
    #math-problem(1, "Tính chu vi hình chữ nhật dài 7 cm, rộng 4 cm")
    #math-problem(2, "Tính diện tích hình chữ nhật dài 9 cm, rộng 6 cm")
    #math-problem(3, "Tính chu vi hình vuông cạnh 5 cm")
    #math-problem(4, "Tính diện tích hình vuông cạnh 8 cm")
    #math-problem(5, "Một hình chữ nhật có chu vi 24 cm, chiều dài 8 cm. Tính chiều rộng")
  ])

  #section-divider()

  #exercise-section("Bài tập luyện tập / Practice Exercises", [
    #math-problem(6, "Một mảnh vườn hình chữ nhật dài 12 m, rộng 8 m. Tính chu vi và diện tích")
    #math-problem(7, "Một hình vuông có diện tích 49 cm². Tính cạnh và chu vi")
    #math-problem(8, "So sánh diện tích: hình chữ nhật 6 cm × 4 cm và hình vuông cạnh 5 cm")
    #math-problem(9, "Một hình chữ nhật có chiều rộng 5 cm, chiều dài gấp đôi chiều rộng. Tính diện tích")
    #math-problem(10, "Một hình vuông có chu vi 36 cm. Tính diện tích")
  ])

  #section-divider()

  #exercise-section("Bài tập tư duy / Thinking Challenges", [
    #math-problem(11, "Một hình chữ nhật có diện tích 48 cm² và chiều dài gấp 3 lần chiều rộng. Tìm kích thước")
    #math-problem(12, "Có thể ghép 4 hình vuông nhỏ cạnh 2 cm thành hình chữ nhật lớn. Tính chu vi hình chữ nhật đó")
    #math-problem(13, "Một hình chữ nhật có chu vi bằng chu vi hình vuông cạnh 10 cm. Chiều dài hơn chiều rộng 4 cm. Tính diện tích")
  ])

  #progress-tracker(4, 3)
]
