// c5-phan-so.typ — Chapter 5: Fractions

#import "_theme.typ": *

#page[
  #chapter-header(5, "Phân Số / Fractions", C-CH.at(4))

  #learning-objectives[
    - Nhận biết phân số ½, ⅓, ¼, ⅕ / Recognize fractions ½, ⅓, ¼, ⅕
    - So sánh phân số đơn giản / Compare simple fractions
    - Biểu diễn phân số bằng hình vẽ / Represent fractions with pictures
  ]

  #section-divider()

  #key-reminder[
    #v(0.3em)
    - Phân số có tử số (trên) và mẫu số (dưới)
    - Mẫu số cho biết tổng số phần bằng nhau
    - Tử số cho biết số phần được lấy
    - Ví dụ: ½ đọc là "một phần hai" (one half)
    - ⅓ đọc là "một phần ba" (one third)
    - ¼ đọc là "một phần tư" (one quarter)
    - ⅕ đọc là "một phần năm" (one fifth)
    - So sánh: cùng tử số, phân số nào có mẫu số lớn hơn thì bé hơn
  ]

  #section-divider()

  #example[
    #v(0.3em)
    Một cái bánh chia làm 4 phần bằng nhau, lấy 1 phần.
    #v(0.3em)
    Phân số biểu diễn: ¼
    #v(0.3em)
    So sánh: ½ > ¼ (vì 1/2 lớn hơn 1/4)
    #v(0.3em)
    So sánh: ⅓ < ½ (vì 1/3 nhỏ hơn 1/2)
  ]

  #section-divider()

  #exercise-section("Bài tập cơ bản / Basic Exercises", [
    #math-problem(1, "Viết phân số biểu diễn phần tô màu: hình tròn chia 3 phần, tô 1 phần")
    #math-problem(2, "Viết phân số biểu diễn: 2 phần trong 5 phần bằng nhau")
    #math-problem(3, "Đọc phân số: ½, ⅓, ¼, ⅕")
    #math-problem(4, "So sánh: ½ ___ ⅓ (điền >, <, =)")
    #math-problem(5, "So sánh: ¼ ___ ⅕")
  ])

  #section-divider()

  #exercise-section("Bài tập luyện tập / Practice Exercises", [
    #math-problem(6, "Một cái bánh chia làm 8 phần, ăn 3 phần. Viết phân số chỉ phần đã ăn")
    #math-problem(7, "So sánh: ⅓ ___ ¼")
    #math-problem(8, "Sắp xếp các phân số theo thứ tự tăng dần: ½, ⅓, ¼")
    #math-problem(9, "Vẽ hình biểu diễn phân số ⅔")
    #math-problem(10, "Một lớp có 30 học sinh, ½ số học sinh là nữ. Hỏi có bao nhiêu học sinh nữ?")
  ])

  #section-divider()

  #exercise-section("Bài tập tư duy / Thinking Challenges", [
    #math-problem(11, "Tìm phân số lớn hơn ½ nhưng nhỏ hơn 1 có mẫu số là 6")
    #math-problem(12, "Một hình chữ nhật được chia thành 6 phần bằng nhau. Tô màu 2 phần. Viết phân số và so sánh với ½")
    #math-problem(13, "Có 2 cái bánh giống nhau. Bánh thứ nhất chia làm 4 phần, bánh thứ hai chia làm 8 phần. Lấy 1 phần từ mỗi bánh. Hỏi phần nào lớn hơn?")
  ])

  #progress-tracker(5, 3)
]
