// nc5-phan-so.typ — Advanced Chapter 5: Advanced Fractions

#import "_theme-nc.typ": *

#page[
  #chapter-header-nc(5, "Phân số nâng cao / Advanced Fractions", C-CH-NC.at(4))

  #learning-objectives-nc[
    - So sánh phân số khác mẫu / Compare fractions with different denominators
    - Cộng trừ phân số cùng mẫu / Add and subtract fractions with same denominator
    - Quy đồng mẫu số đơn giản / Simple common denominator
    - Ứng dụng phân số trong thực tế / Real-world fraction applications
  ]

  #section-divider-nc()

  #key-reminder-nc[
    #v(0.3em)
    - So sánh phân số khác mẫu: quy đồng mẫu số rồi so sánh tử số
    - Cộng trừ cùng mẫu: giữ nguyên mẫu, cộng/trừ tử số
    - Quy đồng: tìm mẫu số chung (thường là tích hai mẫu)
    - Ví dụ: ½ + ⅓ = 3/6 + 2/6 = 5/6
    - English:
      - Compare different denominators: find common denominator, compare numerators
      - Add/subtract same denominator: keep denominator, add/subtract numerators
      - Common denominator: usually product of two denominators
  ]

  #section-divider-nc()

  #example-nc[
    #v(0.3em)
    So sánh ⅔ và ¾
    #v(0.3em)
    Quy đồng: ⅔ = 8/12, ¾ = 9/12
    #v(0.3em)
    Vì 8/12 < 9/12 nên ⅔ < ¾
    #v(0.3em)
    Tính: ⅖ + ⅕ = 3/5
    #v(0.3em)
    Tính: ⅞ - ⅜ = 4/8 = ½
  ]

  #section-divider-nc()

  #exercise-section-nc("Bài tập cơ bản / Basic Exercises", [
    #math-problem-nc(1, "So sánh: ⅔ và ⅘")
    #math-problem-nc(2, "So sánh: ⅚ và ⅞")
    #math-problem-nc(3, "Tính: ⅓ + ⅓")
    #math-problem-nc(4, "Tính: ⅘ - ⅖")
    #math-problem-nc(5, "Quy đồng: ½ và ⅓")
  ])

  #section-divider-nc()

  #exercise-section-nc("Bài tập luyện tập / Practice Exercises", [
    #math-problem-nc(6, "So sánh: ⅗ và ⅘")
    #math-problem-nc(7, "Tính: ⅔ + ⅓")
    #math-problem-nc(8, "Tính: ⅞ - ⅜")
    #math-problem-nc(9, "Quy đồng: ⅔ và ¾")
    #math-problem-nc(10, "Một bánh pizza chia làm 8 phần. Ăn 3 phần. Viết phân số chỉ phần đã ăn và phần còn lại")
    #math-problem-nc(11, "Tính: ⅕ + ⅖")
    #math-problem-nc(12, "Tính: ⅚ - ⅓ (quy đồng)")
  ])

  #section-divider-nc()

  #exercise-section-nc("Bài tập tư duy / Thinking Challenges", [
    #math-problem-nc(13, "Tìm phân số lớn hơn ½ và nhỏ hơn ¾ có mẫu số là 8")
    #math-problem-nc(14, "Một lớp có 30 học sinh. ⅓ số học sinh thích bóng đá, ⅕ thích bóng rổ, còn lại thích cầu lông. Hỏi có bao nhiêu học sinh thích cầu lông?")
    #math-problem-nc(15, "Chứng minh rằng ½ + ⅓ + ⅙ = 1")
  ])

  #progress-tracker-nc(5, 3)
]
