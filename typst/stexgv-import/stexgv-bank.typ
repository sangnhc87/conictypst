  "Q12_AIPRO_3VWT2X": question-tn(
  "%%%=============EX_10=============%%%\nsochc{3}\nCho hình lập phương $ABCD. A'B'C'D'$ có cạnh bằng $6$.\nbegin{chc}\n\tHãy tính $overrightarrow(AC') dot overrightarrow(CD)$?",
  (
    "$0$",
    "$36$",
    "$12sqrt(3)$",
    "$-36$",
  ),
  correct: 4,
  solution: "Phương pháp:\nCạnh $a$: $V = a^3$, $S_(tp) = 6a^2$, đường chéo mặt $= asqrt(2)$, đường chéo khối $= asqrt(3)$.\n\n-  immini{Ta có $overrightarrow(AC') = overrightarrow(AB) + overrightarrow(AD) + overrightarrow(AA')$, $overrightarrow(CD) = -overrightarrow(AB)$.\n\n-  Suy ra\n\t\t\tbegin{eqnarray*}\n\t\t\t\t&overrightarrow{AC'} cdot overrightarrow{CD} & =left(overrightarrow{AB} + overrightarrow{AD} + overrightarrow{AA'}right) cdot overrightarrow{CD}\n\n\t\t\t\t& & =left(overrightarrow{AB} + overrightarrow{AD} + overrightarrow{AA'}right) cdot left(-overrightarrow{AB}right)\n\n\t\t\t\t& & = -overrightarrow{AB}^2 - overrightarrow{AD} cdot overrightarrow{AB} - overrightarrow{AA'} cdot overrightarrow{AB}\n\n\t\t\t\t& & = -6^2 - 0 - 0 = -36.\n\t\t\tend{eqnarray*}\n\t\t\t$( overrightarrow(AD) perp overrightarrow(AB)=> overrightarrow(AD) dot overrightarrow(AB)=0, overrightarrow(AA') perp overrightarrow(AB)=> overrightarrow(AA') dot overrightarrow(AB)=0)$\n\t\t}{\n[Hình/BBT LaTeX cần chuyển sang CeTZ hoặc #bbtv2.]\n}",
  tags: ("stexgv-slot-12", "slot-12", "to-hop-xac-suat", "hinh-lap-phuong", "vecto", "toa-o",),
  difficulty: "TH",
  status: "review",
  source: "Mục tiêu 9+",
  id: "Q12_AIPRO_3VWT2X",
  note: "STEXGV import flags: leftover:sochc, leftover:begin, tikz, leftover:immini, leftover:overrightarrow, leftover:cdot, leftover:left, leftover:right, leftover:end",
),

  "Q12_AIPRO_5BE3HQ": question-tn(
  "Cho hình lập phương $ABCD.A'B'C'D'$ có cạnh đáy bằng $3$. Tính giá trị biểu thức $(overrightarrow(AC')+overrightarrow(BD'))overrightarrow(AB)$?",
