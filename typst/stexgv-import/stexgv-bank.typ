  note: "STEXGV import flags: tikz, leftover:immini, leftover:par, leftover:displaystyle, leftover:int, leftover:limits, leftover:mathrm, leftover:dfrac, leftover:Rightarrow, leftover:left, leftover:right, leftover:cdot",
