  note: "STEXGV import flags: tikz, leftover:immini, leftover:pi, leftover:int, leftover:mathrm, leftover:left, leftover:dfrac, leftover:right, leftover:text, leftover:cdot, leftover:approx",
),

  "Q17_S30D_JJ5NPC": question-tln(
  "%Câu 17\nimmini {Cho hình nón có bán kính đáy bằng $4$, chiều cao bằng $8$. Một khối trụ có bán kính đáy thay đổi và nội tiếp hình nón đã cho (tham khảo hình vẽ). Thể tích của khối trụ đạt giá trị lớn nhất bằng bao nhiêu? (kết quả làm tròn đến hàng phần chục).",
  "59,5",
  solution: "Phương pháp:\nTrên $[a;b]$: tìm nghiệm $f'(x)=0$ trong $(a;b)$, so sánh $f$ tại các điểm đó và $f(a)$, $f(b)$ để xác định GTLN, GTNN.\n\n-  Gọi bán kính đáy của hình trụ là $r$, chiều cao tương ứng là $h$.\n\n-  Dựng thiết diện chứa trục của hình nón, khi đó thiết diện tam giác có đáy là đường kính đáy hình nón dài $2 dot 4 = 8$ và chiều cao $8$, nên tam giác đó có dạng cân đáy $8$, cao $8$.\n\n-  Do hình trụ nội tiếp, nên đáy của hình trụ nằm bên trong hình nón, và chiều cao $h$ của hình trụ sẽ phụ thuộc vào $r$.\n\n-  Từ tam giác đồng dạng, ta có\n    $frac(h, 8) = frac(4 - r, 4) => h = 8 dot frac(4 - r, 4) = 2(4 - r)$.\n\n-  Thể tích khối trụ là\t$V = pi r^2 h = pi r^2 dot 2(4 - r) = 2pi r^2(4 - r)$.\n\n-  Xét hàm số\t$V(r) = 2pi r^2(4 - r) = 2pi (4r^2 - r^3) = 8pi r^2 - 2pi r^3$.\n\n-  Lấy đạo hàm $V'(r) = 16pi r - 6pi r^2 = 2pi r(8 - 3r)$.\n\n-  Cho $V'(r) = 0 => 2pi r(8 - 3r) = 0 => r = 0$ hoặc $r = frac(8, 3)$.\n\n-  Loại $r = 0$, chọn $r = frac(8, 3)$.\n\n-  Khi đó\t$h = 2(4 - r) = 2(4 - frac(8, 3)) = 2 dot frac(4, 3) = frac(8, 3)$.\n\n-  Thể tích là $V = pi r^2 h = pi dot (frac(8, 3))^2 dot frac(8, 3) = pi dot frac(64, 9) dot frac(8, 3) = pi dot frac(512, 27) approx 59(,)6$.",
  tags: ("stexgv-slot-17", "slot-17", "tln-ham-so", "gtln-gtnn-cua-ham-so", "gtln", "hinh-non",),
  difficulty: "VDC",
  status: "review",
  source: "Mục tiêu 7+",
  id: "Q17_S30D_JJ5NPC",
  note: "STEXGV import flags: leftover:immini",
),

  "Q17_S30D_K7SQMI": question-tln(
  "immini{\n\tCho hình lăng trụ tam giác đều $ABC.A'B'C'$ có tất cả các cạnh bằng $a$. Gọi $M$ là điểm nằm trên cạnh $B B'$ sao cho $2 M B' = M B$ và $N$ là trung điểm của $A C$. Tính $tan$ của góc hợp bởi $M N$ và mặt phẳng $(B A' C')$? (Kết quả làm tròn đến hàng phần chục).}{\n[Hình/BBT LaTeX cần chuyển sang CeTZ hoặc #bbtv2.]\n}\n\tpar",
  "$17(,)3$",
  solution: "Phương pháp:\nGóc giữa hai mp: $cosvarphi = frac(|arrow(n_1) dot arrow(n_2)|, |arrow(n_1)| dot |arrow(n_2)|)$ với $arrow(n_1), arrow(n_2)$ là VTPT.\n\n-\n[Hình/BBT LaTeX cần chuyển sang CeTZ hoặc #bbtv2.]\n\nThiết lập hệ trục tọa độ $Oxyz$ như hình vẽ với $a=1$.\n\n-  Dễ dàng ta có $M(0;frac(sqrt(3), 2);frac(1, 3))$ và $N(0;0;1)$. Khi đó $overrightarrow(MN)=(0;-frac(sqrt(3), 2);frac(2, 3))$.\n\n-  Ta có $overrightarrow(n)_(BA'C')= [overrightarrow(OA'),overrightarrow(OB')]=(0;-frac(1, 2);frac(sqrt(3), 4))$.\n\n-  Suy ra\n\\[sin alpha =dfrac{left|overrightarrow{MN},overrightarrow{n}right|}{left|overrightarrow{MN}right|cdotleft|overrightarrow{n}right|}=dfrac{dfrac{sqrt{3}}{4} +dfrac{sqrt{3}}{6}}{sqrt{dfrac{3}{4}+dfrac{1}{9}} cdot sqrt{dfrac{1}{4}+dfrac{3}{16}}}dfrac{10sqrt{903}}{301}.\\]\nDo đó\n\\[tan alpha =dfrac{sin alpha}{cos alpha}=dfrac{sin alpha}{sqrt{1-sin^2 alpha}}=10sqrt{3}approx 17{,3}.\\]",
  tags: ("stexgv-slot-17", "slot-17", "tln-ham-so", "goc-giua-hai-mat-phang", "lang-tru", "mat-phang", "tam-giac", "trung-iem",),
  difficulty: "VD",
  status: "review",
  source: "Mục tiêu 7+",
  id: "Q17_S30D_K7SQMI",
  note: "STEXGV import flags: tikz, leftover:immini, leftover:par, leftover:sin, leftover:alpha, leftover:dfrac, leftover:left, leftover:overrightarrow, leftover:right, leftover:cdot, leftover:sqrt, leftover:tan, leftover:cos, leftover:approx",
),

  "Q17_S30D_OOU2MQ": question-tln(
  "immini{Cho tứ diện đều $ABCD$ có cạnh bằng $1$ m. Một mặt cầu $(S)$ tiếp xúc với ba đường thẳng $AB$, $AC$, $AD$ lần lượt tại $B$, $C$, $D$. Tính diện tích của mặt cầu $(S)$ (đơn vị $m^2$, kết quả làm tròn đến hàng phần chục).}{\n\n[Hình/BBT LaTeX cần chuyển sang CeTZ hoặc #bbtv2.]\n\n}",
  "6{,}3",
  solution: "Phương pháp:\n$V = frac(4, 3)pi R^3$, $S = 4pi R^2$. Phương trình: $(x-a)^2+(y-b)^2+(z-c)^2 = R^2$.\n\n-\n\n        begin{tabular}{cc}\n\n[Hình/BBT LaTeX cần chuyển sang CeTZ hoặc #bbtv2.]\n hspace*{3cm}&\n\n[Hình/BBT LaTeX cần chuyển sang CeTZ hoặc #bbtv2.]\n\n        end{tabular}\n\n    Gọi $O$ là tâm mặt cầu $(S)$, $M$ là trung điểm $CD$ và $G$ là trọng tâm tam giác $BCD$.\n\n-  Ta có $BG=frac(2, 3)BM = frac(2, 3) dot frac(sqrt(3), 2)=frac(sqrt(3), 3)$.\n\n-  Lại có $triangle ABO$ vuông tại $B$ và có đường cao $BG$. Do đó\n    \\[dfrac{1}{BG^2}=dfrac{1}{BA^2}+dfrac{1}{BO^2}Rightarrow dfrac{1}{BO^2}=dfrac{1}{left(frac{sqrt{3}}{3}right)^2}-dfrac{1}{1^2}=2 Rightarrow OB^2 = dfrac{1}{2}.\\]\n    Vậy diện tích mặt cầu $(S)$ là $S=4pi OB^2 = 2pi approx 6(,)3$.",
  tags: ("stexgv-slot-17", "slot-17", "tln-ham-so", "mat-cau", "dien-tich", "uong-thang", "tu-dien",),
  difficulty: "VD",
  status: "review",
  source: "Mục tiêu 9+",
  id: "Q17_S30D_OOU2MQ",
  note: "STEXGV import flags: tikz, leftover:immini, leftover:begin, leftover:hspace, leftover:end, leftover:dfrac, leftover:Rightarrow, leftover:left, leftover:frac, leftover:sqrt, leftover:right",
),

  "Q17_S30D_R49XZA": question-tln(
  "Cho hình chóp đều $S.ABCD$ có tất cả các cạnh bằng $1$, gọi $M$ là một điểm nằm trên cạnh $BC$ sao cho cosin của góc tạo bởi đường thẳng $SA$ và $DM$ bằng $frac(sqrt(5), 10)$. Tính thể tích của khối chóp $S.ADCM$ (kết quả làm tròn đến hàng phần trăm).",
  "$0(,)18$",
  solution: "Phương pháp:\nCông thức: $V = frac(1, 3) S_(đáy) dot h$, trong đó $h$ là đường cao từ đỉnh đến mặt đáy.\n\n-  immini{\n\tChọn hệ trục toạ độ như hình vẽ. Ta có $A(0; -frac(1, sqrt(2)); 0)$, $B(frac(1, sqrt(2)); 0; 0)$, $C(0; frac(1, sqrt(2)); 0)$, $D(-frac(1, sqrt(2)); 0; 0)$ và $S(0; 0; frac(1, sqrt(2)))$.\n\n-  Khi đó $overrightarrow(SA) = (0; -frac(1, sqrt(2)); -frac(1, sqrt(2))) = -frac(1, sqrt(2))(0; 1; 1)$.\n\n-  Đặt $CM = m$ ($0 le m le 1$) thì $overrightarrow(CM) = moverrightarrow(CB) = m(frac(1, sqrt(2)); -frac(1, sqrt(2)); 0)$.\n\n}{\n\n[Hình/BBT LaTeX cần chuyển sang CeTZ hoặc #bbtv2.]\n\n}\nnoindent Ta có $overrightarrow(DM) = overrightarrow(DC) + overrightarrow(CM) = (frac(1+m, sqrt(2)); frac(1-m, sqrt(2)); 0) = frac(1, sqrt(2))(1+m; 1-m; 0)$.\n\n-  Theo đề $cos (SA, DM) = frac(|1 - m|, sqrt(2(1-m^2))) = frac(sqrt(5), 10) <=> m = frac(1, 2) \" hoặc \" m = 2 \" (loại)\"$.\n\n-  Vậy $V_(S.ADCM) = frac(1, 3) dot frac(1, sqrt(2)) dot frac(1(1 + 0(,)5), 2) = frac(sqrt(2), 8) approx 0(,)18$.",
  tags: ("stexgv-slot-17", "slot-17", "tln-ham-so", "the-tich-hinh-chop", "the-tich", "hinh-chop", "uong-thang",),
  difficulty: "VD",
